<pre "create_java">
<b>CREATE</b> [ <b>OR REPLACE</b> ] [ <b>AND</b> { <b>RESOLVE | COMPILE</b> } ] [ <b>NOFORCE</b> ]
  <b>JAVA</b> { { <b>SOURCE | RESOURCE</b> } <b>[IF NOT EXISTS]</b> <b>NAMED</b> [ schema. ] primary_name
       | <b>CLASS</b> [ <b>SCHEMA</b> schema ]
       }
  [ invoker_rights_clause ]
  [ <b>RESOLVER</b> ( {(match_string [,] { schema_name | - })}...) ]      -- perpahs should allow ")..." syntax
  { <b>USING</b> { <b>BFILE</b> (directory_object_name, server_file_name)
          | { <b>CLOB</b> | <b>BLOB</b> | <b>BFILE</b> } subquery
          | string_literal       -- was 'key_for_blob'
          }
  | <b>AS</b> compilationUnit   --java_class   -- more descriptive name
  } [;|/]
</pre>

