++14;   --Re: Eugene Perkov 
` joinsandfilters: [simCond) simple_comparison_condition
;

filters: [simCond) simple_comparison_condition
 & [literal) literal
 & simCond < literal
;

joinsonly: ([simCond]|joinsandfilters) - ([simCond]|filters);

innerjoinSources: [voIden) identifier
 & [simEx) column
 & simEx^ = joinsonly.simCond
 & voIden^^ = simEx
;

innerjoinedVOs: [unPrunedVO) query_table_expression
    & [qBlock) query_block
    & [voAlias) identifier
    & unPrunedVO = qBlock^
    & voAlias^ = unPrunedVO^
    & ? voAlias = ? innerjoinSources.voIden    
;

"unprunedVO": ([unPrunedVO]|innerjoinedVOs);
`

:
 
