`CREATE json relational duality VIEW ORDERS_DUALV AS select JSON
{
  'OrderId' is ord.order_id,
  'id' is generated using path '$.OrderId.number()',
  'OrderItems' is
  (
    select json_arrayagg
    (
      json_object
      (
        'LineItemID' is oi.line_item_id,
        'UnitPrice' is oi.unit_price hidden,
        'Quantity' is oi.quantity,
        'productInfo' is
        (
          select json
          {
            'ProductId' is products.product_id,
            'ProductName' is products.product_name,
            'UnitPrice' is products.unit_price
          }
          from products with (NOINSERT, UPDATE, NODELETE)
          where products.product_id = oi.product_id
        ),
        'TotalItemCost' is GENERATED USING PATH '@.Quantity * @.productInfo.UnitPrice'  -- generated
      )
    )
    from order_items oi where ord.order_id = oi.order_id
  ),
  'OrderTotal' : GENERATED USING PATH '@.OrderItems[*].TotalItemCost.sum()'    -- generated
}
from orders ord;
`  
