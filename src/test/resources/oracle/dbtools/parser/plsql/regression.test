  i interval day to second(3) := (d2 - d1) day to second;
BEGIN
  ctx := dbms_mle.create_context();
  dbms_mle.eval(ctx, 'JAVASCRIPT', prelude);
  dbms_mle.export_to_mle(ctx, 'i', i);
  dbms_mle.eval(ctx, 'JAVASCRIPT', q'~run();~');
  dbms_mle.export_to_mle(ctx, 'i', interval '11' day);
  dbms_mle.eval(ctx, 'JAVASCRIPT', q'~run();~');
  dbms_mle.export_to_mle(ctx, 'i', interval '12' hour);
  dbms_mle.eval(ctx, 'JAVASCRIPT', q'~run();~');
  dbms_mle.export_to_mle(ctx, 'i', interval '13' minute);
