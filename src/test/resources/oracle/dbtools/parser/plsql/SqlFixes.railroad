     expr
)</PRE>

<pre cast><b>CAST</b>({ expr | <b>MULTISET</b> scalar_subquery_expression } <b>AS [DOMAIN]</b> datatype --> was: type_name
 [ <b>DEFAULT</b> expr <b>ON CONVERSION ERROR</b> ]
  [, string_literal [, string_literal ] ]
  [<b> VALIDATE | NOVALIDATE  </b>]
)
</pre>

<PRE translate_using>
<B>TRANSLATE</B> ( expr <B>USING</B>
          { <B>CHAR_CS</B> | <B>NCHAR_CS</B> | identifier % <B>CHARSET</B> }
          )</PRE>

<PRE cluster_probability>
<B>CLUSTER_PROBABILITY</B> ( [ schema . ] model
   [ , literal ] mining_attribute_clause )
</PRE>

<pre cluster_prob_analytic>
   <b>CLUSTER_PROBABILITY</b>    mining_analytic_body
</pre>

<PRE cluster_set>
<B>CLUSTER_SET</B> ( [ schema . ] model [ , expr [ , expr ] ] mining_attribute_clause )
</PRE>

<PRE cluster_set_analytic>
<B>CLUSTER_SET</B> mining_analytic_body
</PRE>


<PRE feature_set>
<B>FEATURE_SET</B>( [ schema . ] model [, expr [, expr ] ] mining_attribute_clause )
</PRE>

<PRE feature_set_analytic>
<B>FEATURE_SET</B> mining_analytic_body
</PRE>


<PRE feature_value>
<B>FEATURE_VALUE</B>( [ schema . ] model [, expr ] mining_attribute_clause ) 
</PRE>

<pre feature_details>
<b>FEATURE_DETAILS</b> ( [ schema . ] model
        [ , expr [ , topN ] ] [ <b>DESC | ASC | ABS</b> ]
        mining_attribute_clause )
</pre>

<pre mining_attribute_clause>
<b>USING</b>
[ * 
| { [ schema . ] table . * 
  | expr [ [<b>AS</b>] alias ]    --<< AS optional in doc examples
  }
    [, { [ schema . ] table . * 
       | expr [ [<b>AS</b>] alias ]
       }
    ]...
]
</pre>


<pre prediction_bounds>
<b>PREDICTION_BOUNDS</b>
( [schema.] model
  [, literal [, literal]]
  mining_attribute_clause
)</pre>

<PRE prediction_set>
<B>PREDICTION_SET</B> ( [ schema . ] model [ , expr [ , expr ] ] 
  [ cost_matrix_clause ] [mining_attribute_clause] )
</PRE>

<PRE prediction_set_analytic>
  prediction_set <b>OVER</b> ( mining_analytic_clause )
| prediction_set <b>OVER</b>  mining_analytic_clause  
</PRE>

<pre prediction_analytic>
<b>PREDICTION</b> ( anomalouS_eXpreSsion [ cost_matrix_clause ] mining_attribute_clause ) -- was(), missing bold
                   <b>OVER</b> ( mining_analytic_clause )
|                   
<b>PREDICTION</b> ( anomalouS_eXpreSsion [ cost_matrix_clause ] mining_attribute_clause ) -- was(), missing bold
                   <b>OVER</b>  mining_analytic_clause 
</pre>

<pre prediction_details>
<b>PREDICTION_DETAILS</b> ( [ schema . ] model 
                      [ , class_value [ , topN ] ] [ <b>DESC | ASC | ABS</b>] -- bold
                       mining_attribute_clause )
</pre>

<pre prediction_details_analytic>
<b>PREDICTION_DETAILS</b> ( anomalouS_eXpreSsion
     [ , class_value [ , topN ] ] [ <b>DESC | ASC | ABS</b> ]
      mining_attribute_clause )
      <b>OVER</b> ( mining_analytic_clause )
|      
<b>PREDICTION_DETAILS</b> ( anomalouS_eXpreSsion
     [ , class_value [ , topN ] ] [ <b>DESC | ASC | ABS</b> ]
      mining_attribute_clause )
      <b>OVER</b> mining_analytic_clause 
</pre>

<pre prediction_prob_analytic>
<b>PREDICTION_PROBABILITY</b> (   anomalouS_eXpreSsion
   [ , class_value ]
   mining_attribute_clause )
   <b>OVER</b> (mining_analytic_clause )
|
<b>PREDICTION_PROBABILITY</b> (   anomalouS_eXpreSsion
   [ , class_value ]
   mining_attribute_clause )
   <b>OVER</b> mining_analytic_clause 
   
</pre>

<pre prediction_cost_analytic>
<b>PREDICTION_COST</b> (  anomalouS_eXpreSsion
   [ , string_literal ]
   cost_matrix_clause mining_attribute_clause )
   <b>OVER</b> (mining_analytic_clause )
|   
<b>PREDICTION_COST</b> ( anomalouS_eXpreSsion
   [ , string_literal ]
   cost_matrix_clause mining_attribute_clause )
   <b>OVER</b> mining_analytic_clause
</pre>


<pre anomalouS_eXpreSsion> 
  <b>OF ANOMALY</b>
| <b>OF ANOMALY</b> expr
| <b>FOR</b> expr
| expr
</pre>

<PRE nth_value>{ 
  <b>NTH_VALUE</b>(measure_expr, measure_expr)     
  [ from_first_last ][ respect_ignore_nulls ] 
  <b>OVER</b> (analytic_clause)
|
  <b>NTH_VALUE</b>(measure_expr, measure_expr)
  [ from_first_last ][ respect_ignore_nulls ] 
  <b>OVER</b> analytic_clause  
}</pre>

<pre from_first_last>
    <b>FROM</b> { <b>FIRST</b> | <b>LAST</b> }
</pre>
 
<pre measure_expr>{
   expr [ from_first_last ][ respect_ignore_nulls ]
}</pre>
  


<pre xmlexists>
<b>XMLEXISTS</b> ( /*{string_literal|bind_var}*/expr [ XML_passing_clause ] )
</pre>

<pre XML_condition>
   xmlexists
|  expr <b>NOT XMLTYPE</b>   -- 33853950
</pre>

<PRE xmlquery>
<B>XMLQUERY</B>
 ( /*{string_literal | identifier}*/expr
   [ XML_passing_clause ] 
   <B>RETURNING CONTENT [NULL ON EMPTY]</B> 
 )
|
 <B>XMLQUERY</B>
 ( /*{string_literal | identifier}*/expr 
   [ XML_passing_clause ] 
   <B>RETURNING SEQUENCE [BY REFERENCE]</B> 
 )
</PRE>

/*<PRE XML__passing_clause>
<b>PASSING [ BY VALUE ]</b> 
    expr [ <b>AS</b> identifier ]
      [, expr [ <b>AS</b> identifier ] 
      ]...
</PRE>*/      
 
<pre XMLnamespaces_clause>
<b>XMLNAMESPACES</b>
  ( { /*string*/ expr <b>AS</b> identifier  |  <b>DEFAULT</b> string }     -- was: } | {
      [, { /*string*/ expr <b>AS</b> identifier  |  <b>DEFAULT</b> string } ]...
  )
</pre>
 
<PRE XMLSchema_spec>
  [ <B>XMLSCHEMA</B> XMLSchema_URL ]
[<B>ELEMENT</B> { element | XMLSchema_URL <B>#</B> element } ]
  [ <b>ALLOW ANYSCHEMA
  | ALLOW NONSCHEMA
  | DISALLOW NONSCHEMA</b>
  ]...
</PRE>

  
<pre listagg>
<b>LISTAGG | [SYS .] STRAGG</b>( [ <b>ALL | DISTINCT | UNIQUE</b> ]
     expr [, expr] -- 24695983
          /*[, string_literal]*/ 
      [listagg_overflow_clause] )
  [<b>WITHIN GROUP</b> (order_by_clause)] 
  [<b>OVER</b> 
  ([query_partition_clause | identifier])  -- missing paren, also: select listagg(ename, ';') within group (order by sal) over (w5) elist
  ]
</pre>

<pre listagg_overflow_clause>
{ <b>ON OVERFLOW ERROR</b> }
|
{ <b>ON OVERFLOW TRUNCATE</b> [ string_literal | <b>NULL</b> ] [ { <b>WITH</b> | <b>WITHOUT</b> } <b>COUNT</b> ] }
</pre>

<PRE object_privilege> 
{ 
<b>INHERIT PRIVILEGES |         
INHERIT ANY PRIVILEGES |         
--select distinct '' || REPLACE(name,' ',' ') || ' |' from TABLE_PRIVILEGE_MAP 
ALTER |
AUDIT |
COMMENT |
DELETE |
GRANT |
INDEX |
INSERT |
LOCK |
RENAME |
SELECT |
UPDATE |
REFERENCES |
EXECUTE |
CREATE |
READ |
WRITE |
KEEP SEQUENCE |
ENQUEUE |
DEQUEUE |
UNDER |
ON COMMIT REFRESH |
QUERY REWRITE |
DEBUG |
FLASHBACK |
MERGE VIEW |
USE |
FLASHBACK ARCHIVE |
SIGN |
COLLECT DEBUG INFO </b>                                                                                                                                                                                                                                                                                                                      
}                                                                                                                                                                                                                                                                                                                        
</PRE>


<pre on_object_clause> [  -- need optional to fix doc_plsql.test 
                          -- ++296;  /*  subprograms.htm#sthref776  */
                          -- GRANT INHERIT ANY PRIVILEGES TO unit_owner
<b>ON</b> { [ schema. ] object    -- was "ON"
   | <b>USER</b> user [, user]...
   | <b>DIRECTORY</b> directory_name
   | <b>EDITION</b> edition_name
   | <b>MINING MODEL</b> [ schema. ] mining_model_name
   | <b>JAVA</b> { <b>SOURCE</b> | <b>RESOURCE</b> } [ schema. ] object
   | <b>SQL TRANSLATION PROFILE</b> [ schema. ] profile
   }
]
</pre>


<PRE datafile_tempfile_spec>
[ string_literal 
| <B>SIZE</B> size_clause 
| <B>REUSE</B>
| autoextend_clause 
| <b>UNIFORM</b>]...
</PRE>


<pre tablespace_group_clause>
<b>TABLESPACE GROUP</b> string 
</pre>

<PRE datafile_tempfile_clauses>   -- 'filename' -> string_literal & file_number -> number
{ <B>ADD</B> { <B>DATAFILE</B> | <B>TEMPFILE</B> }
   [ file_specification [, file_specification ]... ]
| <B>DROP</B> {<B>DATAFILE</b> | <b>TEMPFILE</b> } { string_literal | number }
| <B>SHRINK TEMPFILE</b> { string_literal | number } [<b>KEEP</b> size_clause]
| <B>RENAME</B> <B>DATAFILE</B> string_literal [, string_literal ]...
    <B>TO</B> string_literal [, string_literal ]...
| { <B>DATAFILE</B> | <B>TEMPFILE</B> } { <B>ONLINE</B> | <B>OFFLINE</B> }
}</PRE>


<PRE interval_expression>( expr - expr )
   { <b>DAY</b> [ ({digits| bind_var}) ] <b>TO</b>
     <b>SECOND</b> [ ({digits| bind_var}) ]
   | <b>YEAR</b> [ ({digits| bind_var}) ] <b>TO</b>
     <b>MONTH</b>
   } 
   | interval_day_to_second
   | interval_year_to_month
</PRE>
   

<PRE interval_day_to_second> 
<B>INTERVAL</B> {string_literal | bind_var}
{ { <B>DAY</B> | <B>HOUR</B> | <B>MINUTE</B> } [ ({digits| bind_var}) ]
| <B>SECOND</B> [ ({digits| bind_var} [, {digits| bind_var} ]) ]
}
[ <B>TO</B> { <B>DAY</B> | <B>HOUR</B> | <B>MINUTE</B> | <B>SECOND</B> [ ( {digits| bind_var} ) ] } ]
</PRE>

<PRE interval_year_to_month>
<B>INTERVAL</B> {string_literal | bind_var}
{ <B>YEAR</B> | <B>MONTH</B> } [ ({digits| bind_var}) ]
[ <B>TO</B> { <B>YEAR</B> | <B>MONTH</B> } ]
</PRE>

<pre create_table><B>CREATE</B> [ 
      { <B>GLOBAL</B> | <B>PRIVATE</B> } <B>TEMPORARY</B> 
      |  <B>SHARDED</B> | <B>DUPLICATED</B> 
      | <B>BLOCKCHAIN</B> 
      | <B>IMMUTABLE</B> 
      | <B>IMMUTABLE BLOCKCHAIN</B> 
      | <B>JSON [COLLECTION]</B>   
   ] 
   <B>TABLE [IF NOT EXISTS]</B>
  [ schema. ] colmapped_query_name --table
  [ <B>SHARING</B> = { <B>METADATA | DATA | EXTENDED DATA | NONE | OBJECT</b> }
  | <B>UNRECOVERABLE</B>
  | <B>FOR STAGING</B>
  ]
  { relational_table | object_table | XMLType_table | [json_collection_table] [relational_table] }
  [ <B>MEMOPTIMIZE FOR</B> {<B>READ | WRITE</B>} 
  | <B>PARENT</B> [ schema. ] colmapped_query_name /*table*/ 
  --| , [ <B>DOMAIN</B> ] [identifier.]identifier (column_name_list) ] [<B>USING</B> (column_name_list) ]
       <B>REFRESH INTERVAL</B> number <B>{ SECOND | MINUTE | HOUR } </B>
  | <B>SYNCHRONOUS</B> 
  | <B>FOR STAGING</B>
  | <B>FOR EXCHANGE WITH TABLE</B> [ schema. ] identifier
  | annotations_clause
  ]... 
</pre>

<pre relational_table>
[ (relational_properties) ]
[ annotations_clause ]
[ blockchain_table_clauses ]      -- extra ()
[ <b>DEFAULT COLLATION</b> collation_name ]
[ <b>ON COMMIT</b> { <b>DROP</b> | <b>PRESERVE</b> } <b>DEFINITION</b> ]
[ <b>ON COMMIT</b> { <b>DELETE</b> | <b>PRESERVE</b> } <b>ROWS</b> ]
[ physical_properties ]
[ table_properties ]
</pre>


<pre varray_item> expr | dont_substitute
</pre>

<pre varray_storage_clause>
<B>STORE AS [SECUREFILE | BASICFILE] LOB</B>
[ [LOB_segname] ( LOB_storage_parameters )      -- was {} e.g. bug 32527598
| LOB_segname
]
|
<B>STORE AS TABLE</B> identifier
</pre>


<PRE expr#> -- single alternative here (rules are prioritized)
{ simple_expression
| compound_expression
| case_expression
| cursor_expression
| datetime_expression
| function_expression
| interval_expression
| object_access_expression
| scalar_subquery_expression
| model_expression
| type_constructor_expression
-- missing:
| multiset_expression   -- fix for 12350361
| JSON_object_access_expr 
| json_object
| fuzzy_match
} </PRE>


<PRE expr> -- single alternative here (rules are prioritized)
{ expr#
| expr# <B>COLLATE</B> identifier -- plsql collate_opt has empty alternative
| <b>OLD</b> expr#
| <b>NEW</b> expr#
} </PRE>

<PRE multiset_expression>
{ multiset_except
| multiset_intersect
| multiset_union
}</PRE>


<PRE create_directory>
<B>CREATE</B> [ <B>OR REPLACE</B> ] <B>DIRECTORY [IF NOT EXISTS]</B> identifier
  [<B>SHARING</B> = <B>{METADATA | NONE}</B>]
  <B>AS</B> string_literal 
</PRE>

<PRE set_time_zone_clause>
<B>SET TIME_ZONE</B> =
   string_literal
</PRE>

<pre add_logfile_clauses>
<B>ADD</B> [ <B>STANDBY</B> ] <B>LOGFILE</B>
   { [ <b>INSTANCE</b> string_literal |  <b>THREAD</b> integer ]
     [ <B>GROUP</B> integer ] redo_log_file_spec
       [, [ <B>GROUP</B> integer ] redo_log_file_spec ]...
   | <b>MEMBER</B> string_literal [ <B>REUSE</B> ] [, string_literal [ <B>REUSE</B> ] ]...
        <B>TO</B> logfile_descriptor [, logfile_descriptor ]...
   }</pre>
      
   
<PRE instance_clauses>
{ <B>ENABLE</B> | <B>DISABLE</b> } <b>INSTANCE</b> string_literal
</PRE>

<PRE drop_trigger>
<B>DROP TRIGGER</B> [ schema. ] identifier </PRE>


<pre rolling_migration_clauses>
{ <b>START ROLLING MIGRATION TO</b> string_literal
| <b>STOP ROLLING MIGRATION</b>
}</pre>

<PRE security_clauses>
{ { <B>ENABLE</B> | <B>DISABLE</B> } <B>RESTRICTED SESSION</B>
| <B>SET [ENCRYPTION] WALLET OPEN IDENTIFIED BY</B> identifier 
| <B>SET [ENCRYPTION] WALLET CLOSE</B>
  [ <B>IDENTIFIED BY</B> {identifier|*}  ]
--??| identifier 
| set_encryption_key
}
</PRE>

<pre set_encryption_key>
{ <b>SET ENCRYPTION KEY</b>
  {
    [ identifier ] <b>IDENTIFIED BY</b> identifier
    |
    <b>IDENTIFIED BY</b> identifier [ <b>MIGRATE USING</b> identifier ]
  }
}
</pre>


<pre like_condition>
char1 [ <b>NOT</b> ] { <b>LIKE</b> | <b>LIKEC</b> | <b>LIKE2</b> | <b>LIKE4</b> }
  char2 [ <b>ESCAPE</b> esc_char ]
| regexp_like_condition
 </pre>

<pre regexp_like_condition>
<b>REGEXP_LIKE</b>(expr, expr
            [, expr ]
           )</pre>

<pre flashback_query_clause>
{ <b>VERSIONS BETWEEN</b> { <b>SCN</b> | <b>TIMESTAMP</b> }
    { expr | <b>MINVALUE</b> } <b>AND</b> { expr | <b>MAXVALUE</b> }
| <b>VERSIONS PERIOD FOR</b> /*valid_time_*/column <b>BETWEEN</b>
    { expr | <b>MINVALUE</b> } <b>AND</b> { expr | <b>MAXVALUE</b> }
| <b>AS OF</b> { <b>SCN</b> | <b>TIMESTAMP</b> | <b>SNAPSHOT</b> } expr
| <b>AS OF PERIOD FOR</b> /*valid_time_*/column expr
}...
</pre>


<PRE create_database_link>
<B>CREATE</B> [ <B>SHARED</B> ] [ <B>PUBLIC</B> ] <B>DATABASE LINK [IF NOT EXISTS]</B> [identifier.]... identifier [@ identifier]
  [ "db_link_auth"
  ]...
  [ <B>USING</B> string_literal ] </PRE>
  
<PRE "db_link_auth">
<B>CONNECT TO</B>
    { <B>CURRENT_USER</B>

    | user <B>IDENTIFIED BY</B> password [ dblink_authentication ]
    | user <B>IDENTIFIED BY</B> *
    | user 
    }
  | dblink_authentication  
</PRE>  
  
<PRE in_condition>
{ expr [ <B>NOT</B> ] <B>IN</B> {({ expression_list | subquery }) | expr }
| ( "expr_list" )
    [ <B>NOT</B> ] <B>IN</B> ({ expression_list [, expression_list ]...
                | subquery
                }
               )
|  ( "expr_list" ) [ <B>NOT</B> ] <B>IN</B> values_clause
|     expr         [ <B>NOT</B> ] <B>IN</B> values_clause        
}</PRE>

<PRE overlaps_condition>
{  ( "expr_list" )
    [ <B>NOT</B> ] <B>OVERLAPS</B> ({ expression_list [, expression_list ]...
                }
               )
}</PRE>


<PRE create_library>
<b>CREATE</b> [ <b>OR REPLACE</b> ]
[ <b>EDITIONABLE</b> | <b>NONEDITIONABLE</b> ]
<b>LIBRARY [IF NOT EXISTS]</b> plsql_library_source
</PRE>

<PRE plsql_library_source>
{
  [ schema. ] identifier 
  [<b>TRUSTED</b>] 
  { <b>IS | AS</b> }
  {
      { string_literal | string_literal <b>IN</b> identifier }
      [ <b>AGENT</b> string_literal ] [ <b>CREDENTIAL</b> [schema.]identifier ]
    |
      <b>STATIC</b>
  }   
}
</PRE>


<PRE drop_library>
<B>DROP LIBRARY [IF EXISTS]</B> [ schema. ] identifier 
</PRE>

<PRE order_by_clause>   -- c_alias has been reduced and all that is left is identifier
                        -- whereas going through expr will give column
<B>ORDER</B> [ <B>SIBLINGS</B> ] <B>BY</B>
"ord_by_1desc"
  [, "ord_by_1desc" ]...
</PRE>
  
<PRE "ord_by_1desc">
   expr
     [ <B>ASC</B> | <B>DESC</B> ]
     [ <B>NULLS FIRST</B> | <B>NULLS LAST</B> ]
</PRE>  
  
<PRE unusable_editions_clause>
[ <B>UNUSABLE BEFORE</B> { <B>CURRENT EDITION</B> | <B>EDITION</B> identifier } ]
[ <B>UNUSABLE BEGINNING WITH</B> { <B>CURRENT EDITION</B> | <B>EDITION</B> edition | <B>NULL EDITION</B> } ] -- brackets order
</PRE>

<pre file_name_convert><b>FILE_NAME_CONVERT</b> =
  { ( string_literal, string_literal
      [, string_literal, string_literal ]... )
    |
    <b>NONE</b>
  }</pre>
  
<PRE cycle_clause>{<b>CYCLE</b> c_alias [, c_alias]...
    <b>SET</b> /*cycle_mark_*/c_alias <b>TO</b> /*cycle_value*/ {literal|bind_var}
    <b>DEFAULT</b> /*no_cycle_value*/ {literal|bind_var}
}</PRE>
  
<PRE decompose>
<B>DECOMPOSE</B>( column [ <B>CANONICAL</B> | <B>COMPATIBILITY</B> ] )
</PRE>


<PRE alter_type>  -- -- -- -- -- -- -- -- pl/sql manual
<B>ALTER TYPE [IF EXISTS]</B> [ schema. ]type
  {  <b>EDITIONABLE | NONEDITIONABLE</b> 
  | compile_type_clause
  | replace_type_clause
  | { alter_method_spec
    | "alter_attribute_definition"
    | alter_collection_clauses
    | [ <B>NOT</B> ] { <B>INSTANTIABLE | FINAL</B> }
    }
    [ dependent_handling_clause ]
  | <b>RESET</b>  
  }
;  
</pre>

<pre compile_type_clause>
<B>COMPILE</B>
   [ <B>DEBUG</B> ]
   [ <B>SPECIFICATION | BODY</B> ]
   [ compiler_parameters_clause ] ...
   [ <B>REUSE SETTINGS</B> ]  
</pre>
 
<pre compiler_parameters_clause>
	identifier = expr [, expr]...
</pre>

<pre replace_type_clause>
	<B>REPLACE</B> [ invoker_rights_clause ] <B>AS OBJECT</B>
   (attribute datatype [, attribute datatype ]...   [, element_spec [, element_spec ]... ])
   |
   <B>REPLACE UNDER</B> dotted_name ( adt_field_list ) NOT_opt_FINAL
</pre>
  
  
<pre alter_method_spec>
 { <B>ADD | DROP</B> } { map_order_function_spec | subprogram_spec }
  [, { <B>ADD | DROP</B> } { map_order_function_spec | subprogram_spec } ]... 
</pre>

<pre "alter_attribute_definition">
	 <B>{ ADD | MODIFY } ATTRIBUTE</B>
     { adt_field
     | ( adt_field_list )
     }
| <b>DROP ATTRIBUTE</b>
     { attribute
     | ( attribute [, attribute ]... )
     }
</pre>

<pre alter_collection_clauses>
	<B>MODIFY</B> { <B>LIMIT</B> integer | <B>ELEMENT TYPE</B> datatype }
</pre>

<pre dependent_handling_clause>
	{ <B>INVALIDATE
       | CASCADE [ { [ NOT ] INCLUDING TABLE DATA
            | CONVERT TO SUBSTITUTABLE
            }
          ]</B>
     [ [<B>FORCE</B> ] exceptions_clause ]
}
</pre>

<pre exceptions_clause>
	<B>EXCEPTIONS INTO</B> [ schema. ] table
</pre>

<pre modify_column_clauses><b>MODIFY</b>  
{ ( {modify_col_properties | modify_virtcol_properties | modify_col_visibility }    --<-- missing {}
    [, {modify_col_properties | modify_virtcol_properties | modify_col_visibility} ]... ) 
| modify_col_substitutable
| modify_col_properties
| modify_virtcol_properties
| modify_col_visibility     -- missing e.g. alter table mytable modify column undesired_col_name INVISIBLE;
}
</pre>


<pre modify_virtcol_properties>
virtual_column_definition
</pre>


<pre modify_col_properties>
column [ datatype ] 
       [ <b>RESERVABLE | NOT RESERVABLE</b> ]
	   [ <b>DOMAIN</b> [ schema ] . identifier ]
       [ <b>COLLATE</b> column_collation_name ]
       [ <b>DEFAULT</b> [ <b>ON NULL</b> ] [<b>FOR INSERT {ONLY | AND UPDATE}</b>] expr 
       | identity_clause 
       | <b>DROP</b> <b>IDENTITY</b> 
       ]
       [ inline_constraint ]...                                  -- was: ... ]
       [  <b>ENCRYPT</b> encryption_spec | <b>DECRYPT</b>     
       | LOB_storage_clause 
       | alter_XMLSchema_clause 
       | annotations_clause 
       | <b>REPLACE</b> expr <b>WITH</b> expr
       ]...    
</pre>


<pre grant>
<b>GRANT</b>
  { 
  { { grant_system_privileges | grant_object_privileges } 
    [ <b>CONTAINER</b> = { <b>CURRENT</b> | <b>ALL</b> } ] }
  | grant_roles_to_programs
  } --< missing
  [;] -- optional in examples http://st-doc.us.oracle.com/database/121/LNPLS/subprograms.htm#sthref776  sthref779  
</pre>

<<grant_system_privileges>>
{ system_privilege  | role | ALL PRIVILEGES } [ON [SCHEMA|USER] identifier]
  [, { system_privilege | role | ALL PRIVILEGES } [ON [SCHEMA|USER] identifier] ]...  
[
TO { grantee_clause | grantee_identified_by } [ WITH { ADMIN | DELEGATE } OPTION ]
]
<<>>

<pre package_compile_clause>  -- in PL/SQL manual
<b>COMPILE</b> [ <b>DEBUG</b> ] [<b>PACKAGE | SPECIFICATION | BODY</b> ]
[ identifier = expr [,expr]... ]... [ <b>REUSE SETTINGS</b> ]
</pre>

<pre function_compile_clause>  
plsql_compile_clause  
</pre>

<pre trigger_compile_clause>  
plsql_compile_clause  
</pre>

<pre library_compile_clause>  
plsql_compile_clause  
</pre>

<pre plsql_compile_clause>  
<b>COMPILE</b> [ <b>DEBUG</b> ] [ identifier = expr [, expr]... ]... [ <b>REUSE SETTINGS</b> ]
</pre>

<pre commit>
<b>COMMIT</b> 
   [ <b>WORK</b> 
   | <b>COMMENT</b> string 
   | <b>WRITE</b> 
   | <b>WAIT</b>
   | <b>NOWAIT</b> 
   | <b>IMMEDIATE</b> 
   | <b>BATCH</b> 
   | <b>FORCE</b>  string [, integer ]
   | <b>CORRUPT_XID</b> string
   | <b>CORRUPT_XID_ALL</b>
   ]... 
-- no trailing ;
</pre>

<pre returning_clause>
{ <b>RETURN</b> | <b>RETURNING</b> } expr [, expr ]...
BULK_COLLECT_opt <b>INTO</b> data_item [, data_item ]...
</pre>

<pre data_item> {
          identifier
        | identifier . data_item 
        | :identifier
        | :digits
        | identifier ( "expr_list" ) 
        | identifier ( "expr_list" ) . data_item 
}</pre>

/*<pre bulk_collect_into_clause>  -- pl/sql; leverage BULK_COLLECT_opt instead
BULK COLLECT INTO expanded_and_bind_n 
  [, expanded_and_bind_n ]...
</pre>*/

<pre update_set_clause>
<b>SET</b>
{ update_set_clause_expr
     [, update_set_clause_expr
     ]...
| <b>VALUE</b> ( id_or_qualid  -- e.g. UPDATE ot1 SET VALUE(ot1.x) = t1(20);
) = { expr | (subquery) }
}
</pre>

<pre update_set_clause_expr> -- refactored
{ (column [, column ]...) = { expr | (subquery)}
  | column = { expr | (subquery) | <b>DEFAULT</b> }
  | identifier.column = { expr | (subquery) | <b>DEFAULT</b> }
  }
</pre>

<pre values_clause> {
  <b>VALUES</b> { expr [par_expr_list]    -- composites.htm#BABBCHAI, triggers.htm#CIHFBGDC, 
                 | par_expr_list [, par_expr_list]... }
  [ as_alias_parcol ]                
| 
  ( <b>VALUES</b> par_expr_list [, par_expr_list]... )
  [ as_alias_parcol ] 
| 
  ( <b>VALUES</b> (subquery) )
  [ as_alias_parcol ]   
}</pre>

<pre as_alias_parcol>
   [<b>AS</b>] t_alias ( c_alias[,c_alias]... )
</pre>

<pre par_expr_list>
("expr_list")
</pre>

<pre full_database_recovery>
[ <b>STANDBY</b> ] 
[<b>DATABASE</b>]  -- made optional to parse ALTER DATABASE RECOVER AUTOMATIC UNTIL TIME '2001-10-27:14:00:00'; (statements_1006.htm#SQLRF52573)
[ { <b>UNTIL</b> { <b>CANCEL</b>
          | <b>TIME</b> date
          | <b>CHANGE</b> integer
          | <b>CONSISTENT</b>
          }
  | <b>USING BACKUP CONTROLFILE</b>
  | <b>SNAPSHOT TIME</b> date
  }...
]
</pre>

<pre alter_dimension>
<b>ALTER DIMENSION [IF EXISTS]</b> [ schema. ] dimension
{ -- missing brackets
  { <b>ADD</b> { level_clause
        | hierarchy_clause
        | attribute_clause
        | extended_attribute_clause
        }
  } ...
  |
  { <b>DROP</b> { <b>LEVEL</b> level [ <b>RESTRICT</b> | <b>CASCADE</b> ]
         | <b>HIERARCHY</b> hierarchy
         | <b>ATTRIBUTE</b> attribute [ <b>LEVEL</b> level [ <b>COLUMN</b> column ] ]...
         }
  } ...
  |
  <b>COMPILE</b>
}
  ;
</pre>

<pre pdb_storage_clause>
<b>STORAGE</b>
  { ( { <b>MAXSIZE</b> { <b>UNLIMITED</b> | size_clause }  -- "(" -> "( {"
    |
    <b>MAX_SHARED_TEMP_SIZE</b> { <b>UNLIMITED</b> | size_clause } }... )   --> "}...)" -> "}}...)"
  |
  <b>UNLIMITED</b>
  }
</pre>


<pre XMLType_storage>
<b>STORE</b>
{ <b>AS</b>
	 { <b>OBJECT RELATIONAL</b>
	 | [<b>SECUREFILE | BASICFILE</b>] { <b>CLOB</b> | <b>[[NOT] TRANSPORTABLE] BINARY XML</b> }
	   [ { LOB_segname [ (LOB_storage_parameters) ]   -- was: LOB_parameters
	       | (LOB_storage_parameters)                   -- was: LOB_parameters
	       }
	     ]
	 --| { <b>ALL VARRAYS AS</b> { <b>LOBS</b> | <b>TABLES</b> }  -- with AS???
	 }
|  <b>ALL VARRAYS AS</b> { <b>LOBS</b> | <b>TABLES</b> }  -- doc
}
</pre>

<pre object_properties>
{ { column | attribute }
    [ <b>DEFAULT</b> expr ]
    [ { inline_constraint }...  | inline_ref_constraint ]
| { out_of_line_constraint
  | out_of_line_ref_constraint
  | supplemental_logging_props
  }
| object_properties , object_properties   -- to fix statements_7002.htm#SQLRF54666  
}
</pre>

<pre XMLType_view_clause>
<b>OF [SYS.]XMLTYPE</b> [ XMLSchema_spec ]
[<b>WITH OBJECT</b> {<b>IDENTIFIER | ID | OID</b>}   -- abbreviated "ID" in statements_8004.htm#sthref5882
  { <b>DEFAULT</b> | ( expr [, expr ]...) }]
</pre>

<pre global_partitioned_index>
<B>GLOBAL</b>
{ range_partitions
| hash_partitions
} 
</pre>

<pre hash_partitions>
<b>PARTITION BY HASH</b> (column [, column ] ...)
[ individual_hash_partitions
| hash_partitions_by_quantity
]     -- optional 33901893
</pre>

<pre collection_expression> {
subquery|expr
}
</pre>
    
        
<pre row_pattern_clause>
<b>MATCH_RECOGNIZE</b> (   -- was {
  [ row_pattern_partition_by ]
  [ row_pattern_order_by ]
  [ row_pattern_measures ]
  [ row_pattern_rows_per_match ]
  [ row_pattern_skip_to ]
  <b>PATTERN</b> (row_pattern)
  [ row_pattern_subset_clause ]
  <b>DEFINE</b> row_pattern_definition_list
)
</pre>        
        
<pre row_pattern>
row_pattern_term
| row_pattern <b>sbar</b> row_pattern_term
</pre>

<pre row_pattern_factor>
row_pattern_primary [ row_pattern_quantifier ]      --<-- wrong, should be
                                              ...   ----- iterative e.g. PATTERN (S DOWN+ UP{2}?)
</pre>

<pre row_pattern_primary>
variable_name
| <b>$</b>
| <b>^</b>
| ( [ row_pattern ] )
| <b>lcp</b> - row_pattern - <b>rcp</b>
| row_pattern_permute
</pre>

<pre row_pattern_quantifier>
* [ ? ]
| + [ ? ]
| ? [ ? ]
| <b>lcp</b> [ integer ] , [ integer ] <b>rcp</b> [ ? ]
| <b>lcp</b> integer <b>rcp</b>
</pre>

<pre constraint>  -- loaded name
{ inline_constraint
| out_of_line_constraint
| inline_ref_constraint
| out_of_line_ref_constraint
---- added ----
| id_or_qualid  
| identifier . identifier @ dblink
| identifier @ dblink
}
</pre>

<pre explain_plan>
<b>EXPLAIN PLAN</b>
   [ <b>SET STATEMENT_ID</b> [=] string ]
   [ <b>INTO</b> [ schema. ] table [ @ dblink ] ]
<b>FOR</b> {sql_stmt | create | alter}
     /*[row_limiting_clause]      -- to fix optimization issue
                                -- "order by x desc" conflicts with [DESC]RIBE command
                                -- Alt solution: make DESCRIBE recognizable at lexical analysis level
                                introduced Earley.isOptimizable() 
                                */ 
;   -- statement -> sql_stmt
</pre>

