create domain d as (c3 as number, c4 as boolean not null) 
display (c1>c2) = c4 order (c1>c2)>c4;

create flexible domain fd (c) 
choose domain using (typ1 number, typ2 number, typ3 boolean) 
from case when  ((typ1 > typ2) > typ3) then d1(c) else d2(c) end;

create domain e_not_null as enum(a, b, c) not null;

create domain enum_def as enum (a, b, c) default 3;

create domain d as (c1 as number or char(10) not null default 1, 
c2 as char(20) or float not null check (c2 >= 0) default 0)
constraint dgreater check (c1 > c2)
constraint drange check (c1 - c2 <= 1000)
display '[' || to_char(c1-c2) || ']'
order c1-c2;
