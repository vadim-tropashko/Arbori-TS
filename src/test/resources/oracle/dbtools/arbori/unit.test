"/src/main/resources/oracle/dbtools/arbori/find_declaration.prg" : 
create
PROCEDURE Generate_OS_File(v_blob IN BLOB ) IS

l_buffer        RAW(32767);

BEGIN 
  declare
     total_cnt   integer;
     max_cnt   integer;
  cursor column_cur(tname  varchar2)  is
    select distinct column_name  col,
           b.table_name tab,
           b.table_owner own
           from dba_ind_columns;
  begin
     total_cnt := 1;
     FOR i in 0..MAX LOOP
         exit when Table_List(i) is null;
         for c_rec in column_cur(Table_List(>!<i)) loop
             sql_string := 'select ';
         end loop;
     END LOOP;
  end;
 

    l_pos := 1;
 
END Generate_OS_File;

