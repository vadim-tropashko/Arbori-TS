<PRE external_table_data_props>
[<B>DEFAULT DIRECTORY</B> identifier [.identifier]]
[ <B>ACCESS PARAMETERS</B>
  { (opaque_format_spec) |
   <B>USING CLOB</B> subquery |
   ( [<b>LOGFILE</b>] string_literal)       -- 33849012, 35782114
  }
]
[<B>LOCATION</B>
   ([ identifier: ] string_literal
      [, [ identifier: ] string_literal ]...
   )
]
</PRE>

<PRE opaque_format_spec>
[
      record_format
    | record_format2
    | <b>TERRITORY</b> identifier
    | fields_def
    | hive
    | <B>VERSION</B> string_literal
    | <B>/</B>
    | <B>COMPRESSION</B>
    | <B>ENABLED</B>
    | <B>MEDIUM</B>
    | <B>DISCARDFILE</B>
]...
</PRE>

<PRE record_format> {
     <B>RECORDS</B> 
    |<B>FIXED</B> integer 
    | <B>VARIABLE</B> integer 
    | <B>DELIMITED BY</B> { [<B>DETECTED</B>] <B>NEWLINE</B> | ext_tbl_string_literal } 
    | <B>IGNORE_BLANK_LINES</B>
    | <B>IGNORE_HEADER</B> = digits
    | <B>CREDENTIAL</B> string_literal
	| <b>DNFS_DISABLE</b>
}
</PRE>

<PRE ext_tbl_string_literal>
  [<B>X</B> | number <B>X</B>]
  {  string_literal
   | identifier } -- cumbersome case for double quoted strings; 
                  -- will not complicate lexical analysis just for that little thing 
</PRE>

<PRE record_format2>  {
    <B>CHARACTERSET</B> string
    |<B>DATA IS { LITTLE | BIG } ENDIAN</B>
    |<B>BYTEORDERMARK { CHECK | NOCHECK } </B>
    |<B>STRING SIZES ARE IN { BYTES | CHARACTERS }</B>
    |<B>LOAD WHEN</B> condition_spec 
    |<B>LOAD WHEN</B> ( (digits:digits) = string_literal ) 
    |{ <B>PREPROCESSOR_TIMEOUT</B> integer | <B>PREPROCESSOR</B> filename } 
    |{ <B>NOBADFILE</B> |  <B>BADFILE</B> filename } 
    |{ <B>NODISCARDFILE</B> | <B>DISCARDFILE</B> filename } 
    |{ <B>NOLOGFILE</B> | <B>LOGFILE</B> filename } 
    |{ <B>READSIZE</B> [=] integer | <B>DISABLE_DIRECTORY_LINK_CHECK</B> | <B>DATE_CACHE</B> integer | <B>SKIP</B> integer}
  }
</PRE>

