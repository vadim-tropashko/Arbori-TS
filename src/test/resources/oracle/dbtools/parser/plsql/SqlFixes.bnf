     --soda get fruit 
     --soda get fruit -f {"name" : "orange"}
     --soda get fruit -f {"quantity" : {"$lt" : 50}} 
     --
|    'SODA' 'REMOVE' identifier (('-' 'ALL' | '-' 'F' | '-' 'K' | '-' 'KLIST') (hvalue)?)?
