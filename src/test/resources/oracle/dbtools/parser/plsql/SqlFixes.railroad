| consistent_hash_with_subpartitions
} 
[ partitioning_storage_clause
| partitionset_clauses
| <B>FOR EXCHANGE WITH TABLE</B> identifier
]...   
</PRE>

<PRE range_values_clause>
<B>VALUES LESS THAN</B>
  ({ expr | <B>MAXVALUE</B> }   --> literal -> expr , e.g. VALUES LESS THAN (TO_DATE('01-APR-1998','DD-MON-YYYY'))
     [, { expr | <B>MAXVALUE</B> } ]...
  )</PRE>
  
