<B>CREATE DATAFILE [IF NOT EXISTS]</B>
   { string_literal | digits }
     [, string_literal | digits ]...
   [ <B>AS</B> { file_specification
          [, file_specification ]...
        | <B>NEW</B>
        }
   ]</pre>
   
<pre alter_datafile_clause>
<B>DATAFILE</B>
   { string_literal | digits | /*filename -- too broad*/ identifier . identifier }
     [, string_literal | digits | /*filename*/ identifier . identifier ]...
   [  -- optional to parse ALTER DATABASE DATAFILE 'data_file_name' ENABLE LOST WRITE PROTECTION
     <B>ONLINE</B>
   | <B>OFFLINE</B> [ <B>FOR DROP</B> ]
   | <B>RESIZE</B> size_clause
   | autoextend_clause
   | <B>END BACKUP</B>
   ]</pre>   
   
