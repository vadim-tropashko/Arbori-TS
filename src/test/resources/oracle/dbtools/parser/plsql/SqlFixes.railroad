<pre object_access_expression>
{ table_alias.column.
| object_table_alias.
| (expr).
}
{ attribute [.attribute ]...
  [.method_call ]...
| method_call [.method_call ]...
}
</pre>

<pre method_call>
method ([ argument [, argument ]... ])
</pre>

<pre type_constructor_expression>
[ <b>NEW</b> ] [ schema. ]type_name
   paren_expr_list                            --was: ([ expr [, expr ]... ])
</pre>

<<constraint_clauses>>
{ ADD { { out_of_line_constraint }...
      | out_of_line_REF_constraint
      }
   | MODIFY { { CONSTRAINT constraint_name [ precheck_state ]
             | PRIMARY KEY
             | UNIQUE (column [, column ]...) }
          [constraint_state]  [ CASCADE ] }
   | RENAME CONSTRAINT old_name TO new_name
   | { drop_constraint_clause }...
}
<<>>

<pre constraint_state> 
{
   [<b>NOT</b>] <b>DEFERRABLE</b> [<b>INITIALLY</b> {<b>IMMEDIATE</b> | <b>DEFERRED</b>}] --was: extra ]
 |  <b>INITIALLY</b> { <b>IMMEDIATE</b> | <b>DEFERRED</b> } [[ <b>NOT</b> ]  <b>DEFERRABLE</b> ]
|  <b>RELY</b> | <b>NORELY</b>  
| using_index_clause 
| <b>ENABLE</b> | <b>DISABLE</b> 
| <b>VALIDATE</b> | <b>NOVALIDATE</b> 
| exceptions_clause 
}...</pre>

<pre database_logging_clauses>
{ <b>LOGFILE</b>
    [ <b>GROUP</b> integer ] file_specification
      [, [ <b>GROUP</b> integer ] file_specification ]...
| <b>MAXLOGFILES</b> integer
| <b>MAXLOGMEMBERS</b> integer
| <b>MAXLOGHISTORY</b> integer
| { <b>ARCHIVELOG</b> | <b>NOARCHIVELOG</b> }
| <b>FORCE</b> <b>LOGGING</b>
| <b>SET STANDBY NOLOGGING FOR</b> {<b>DATA AVAILABILITY</b> | <b>LOAD PERFORMANCE</b>} --missing }
}</pre>

<pre create_pluggable_database><b>CREATE PLUGGABLE DATABASE [IF NOT EXISTS]</b>
  { { pdb_name [ <b>AS APPLICATION CONTAINER</b> ] | using_snapshot_clause} | { <b>AS SEED</b> } }
  { create_pdb_from_seed | create_pdb_clone | create_pdb_from_xml | create_pdb_from_mirror_copy 
    | using_snapshot_clause | container_map_clause 
    | pdb_snapshot_clause }                           -- was: } pdb_snapshot_clause 
</pre>

