`create materialized view export_test.emp_data ( employee_id, first_name, x,y )
    build immediate
using index
    refresh
                            fast
                            on demand
                        start with sysdate + 0
                    next sysdate + 7
                with primary key
            using enforced constraints
disable on query computation disable query rewrite disable concurrent refresh as
    select 1;`
->
`CREATE MATERIALIZED VIEW export_test.emp_data (
    employee_id,
    first_name,
    x,
    y
) BUILD IMMEDIATE USING INDEX
    REFRESH FAST
    ON DEMAND
    START WITH sysdate + 0
    NEXT sysdate + 7
    WITH PRIMARY KEY
    USING ENFORCED CONSTRAINTS
    DISABLE ON QUERY COMPUTATION
    DISABLE QUERY REWRITE
    DISABLE CONCURRENT REFRESH
AS
    SELECT
        1;`
; 

