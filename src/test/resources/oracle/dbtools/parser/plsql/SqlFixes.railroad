    | parameter_name = ON                -- keyword
    | EDITION = edition_name
    | CONTAINER = container_name [ SERVICE = service_name ]
    | ROW ARCHIVAL VISIBILITY = { ACTIVE | ALL }
    | DEFAULT COLLATION = { collation_name | NONE }
    | EVENTS literal
    | RECYCLEBIN = { ON | OFF }
    | APPLICATION MODULE = string_literal
    } ...
| RESET identifier
}
