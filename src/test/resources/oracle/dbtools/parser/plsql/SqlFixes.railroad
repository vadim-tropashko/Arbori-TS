</PRE>

<PRE a_f>  
identifier paren_expr_list 
   [keep_clause]
   <B>OVER</B> (analytic_clause)
| identifier paren_expr_list
   [keep_clause]
   <B>OVER</B> analytic_clause 
| aggr_call 
   [keep_clause]
   <B>OVER</B> (analytic_clause)
| aggr_call 
   [keep_clause]
   <B>OVER</B> analytic_clause
</PRE>

<pre rank_clause>
  <b>HIERARCHY</b> hierarchy_ref --[<b>OFFSET</b> digits]
  <b>ORDER</b> <b>BY</b> calc_meas_order_by_clause [ , calc_meas_order_by_clause ]...  
  [ <b>WITHIN</b> { <b>LEVEL</b> | <b>PARENT</b> | <b>ANCESTOR</b> <b>AT</b> <b>LEVEL</b> level_ref } ]  
  [ {<b>INCLUDE</b> | <b>SKIP</b>} <b>WHEN</b> <b>NULL</b> ]
|   
  <b>HIERARCHY</b> hierarchy_ref <b>OFFSET</b> digits [<b>ACROSS ANCESTOR AT LEVEL</b> identifier]  
</pre>

<PRE first_last_value> {
  {<B>FIRST_VALUE</B> | <B>LAST_VALUE</B> }
  { (expr) [ respect_ignore_nulls ]
  | (expr [ respect_ignore_nulls ])
  }
  <B>OVER</B>  (analytic_clause) 
|  
  {<B>FIRST_VALUE</B> | <B>LAST_VALUE</B> }
  { (expr) [ respect_ignore_nulls ]
  | (expr [ respect_ignore_nulls ])
  }
  <B>OVER</B>  analytic_clause 
} </PRE>

<pre sum>
    <b>SUM</b> ([ <b>DISTINCT | ALL</b> ] expr)
   [ <b>OVER</b> (analytic_clause) | <b>OVER</b> analytic_clause | <b>OVER</b> () ]   -- select sum(sal) over w as "total"  from emp
</pre>  

<pre avg>
    <b>AVG</b> ([ <b>DISTINCT | ALL</b> ] expr)
   [ <b>OVER</b> (analytic_clause) | <b>OVER</b> analytic_clause | <b>OVER</b> () ]   -- select sum(sal) over w as "total"  from emp
</pre>  


<pre respect_ignore_nulls> 
{<b>RESPECT</b> | <b>IGNORE</b>} <b>NULLS</b>
</pre>


