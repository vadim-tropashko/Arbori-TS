`create table slack_bugs (
    request_id  varchar2(100) default ( 'REQ0'
                 || slack_bugs_request_id_seq.nextval ),
    bug_description   varchar2(250)
);

BEGIN
    l_signature_raw := 'v0:'
                  || l_request_timestamp
                       || ':'
                       || l_body_text_raw;
        l_signature_raw := 'v0:'
                       || l_request_timestamp;
    
    dbms_output.put_line('hello' || 'world');
END;`
->
`CREATE TABLE slack_bugs (
    request_id      VARCHAR2(100) DEFAULT ( 'REQ0' || slack_bugs_request_id_seq.NEXTVAL ),
    bug_description VARCHAR2(250)
);

BEGIN
    l_signature_raw := 'v0:'
                       || l_request_timestamp
                       || ':'
                       || l_body_text_raw;
    l_signature_raw := 'v0:' || l_request_timestamp;
    dbms_output.put_line('hello' || 'world');
END;`
;

