`SELECT rtd.col1
      ,CASE
          WHEN rtd.col1 = 'N'      THEN (rtd.col1 / 100) * - 1
          WHEN rtd.col1 = 'Y'      THEN (rtd.col1 / 100) * - 1
          WHEN rtd.col1 != 'Y'     THEN (rtd.col1 / 100) * - 1
          ELSE (rtd.col1 / 100) * 1
        END AS prod_prc
      ,t99.col1
  FROM table1;`
->
"SELECT
    rtd.col1,
    CASE
        WHEN rtd.col1 = 'N'  THEN
            ( rtd.col1 / 100 ) * - 1
        WHEN rtd.col1 = 'Y'  THEN
            ( rtd.col1 / 100 ) * - 1
        WHEN rtd.col1 != 'Y' THEN
            ( rtd.col1 / 100 ) * - 1
        ELSE
            ( rtd.col1 / 100 ) * 1
    END AS prod_prc,
    t99.col1
FROM
    table1;"
;  

++3;
    kwCase = Case.UPPER,
`SELECT
    rtd.col1,
    CASE
        WHEN rtd.col1 = 'Y' THEN
            ( rtd.col1 / 100 )  - 1
        ELSE
            ( rtd.col1 / 100 ) * 1
    END AS prod_prc,
    t99.col1
FROM
         table1 rtd
    JOIN table2  t99 ON rtd.str_no = t99.str_no
                       AND CASE
        WHEN rtd.col1 = 'N' THEN
            rtd.col1  - 1
        ELSE
            rtd.col1 / 100 * 1
                           END = rtd.extd_prc
                       AND CASE
        WHEN rtd.can_key_fg = 'N' THEN
            'A'
        ELSE
            'V'
                           END = t99.void_fg`
->
"SELECT
    rtd.col1,
    CASE
        WHEN rtd.col1 = 'Y' THEN
            ( rtd.col1 / 100 ) - 1
        ELSE
            ( rtd.col1 / 100 ) * 1
    END AS prod_prc,
    t99.col1
FROM
         table1 rtd
    JOIN table2 t99 ON rtd.str_no = t99.str_no
                       AND CASE
                               WHEN rtd.col1 = 'N' THEN
                                   rtd.col1 - 1
                               ELSE
                                   rtd.col1 / 100 * 1
                           END = rtd.extd_prc
                       AND CASE
                               WHEN rtd.can_key_fg = 'N' THEN
                                   'A'
                               ELSE
                                   'V'
                           END = t99.void_fg"
;    

