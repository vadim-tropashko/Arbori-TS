<PRE fields_def>
 [ <b>ALL</b> ]
   <b>FIELDS</b> 
 [ <b>CSV</b>
 | <b>[WITH | WITHOUT] EMBEDDED</b>
 | delim_spec
 | trim_spec 
 | <b>OVERRIDE</b>
 ]...
 [<B>MISSING FIELD VALUES ARE NULL</B>]
 [<B>REJECT ROWS WITH ALL NULL FIELDS</B>]
 [<B>NULLIF = BLANKS LRTRIM</B>   ( col_properties  )]
 [et_field_list]
</PRE>

<PRE delim_spec>
{
 <B>ENCLOSED BY</B> delim_str [<B>AND</B> delim_str] 
 | <B>TERMINATED BY</B> { delim_str | <B>WHITESPACE</B> } 
[[<B>OPTIONALLY</B>] <B>ENCLOSED BY</B> delim_str [<B>AND</B> delim_str]]
}...
</PRE>

<PRE delim_str>
{identifier|string_literal}
</PRE> 

<PRE trim_spec>
{ <B>LRTRIM | NOTRIM | LTRIM | RTRIM | LDRTRIM</B> }
</PRE>

<PRE et_field_list>
(et_field_spk 
[,  et_field_spk]...
)
</PRE>

<PRE et_field_spk>
identifier [pos_spec] [datatype_spec] [init_spec]
</PRE>


<PRE pos_spec>
[<B>POSITION</B>] ({ expr | *   }  [:  expr])
[<B>ZONED</B>]
</PRE>

<PRE datatype_spec>
{
 [<B>UNSIGNED</B>] <B>INTEGER</B> [<B>EXTERNAL</B>] [(digits)] [delim_spec] 
|                  <B>NUMBER</B>  [<B>EXTERNAL</B>] [(digits)] [delim_spec]                          
|{ <B>DECIMAL | ZONED</B> } [<B>EXTERNAL</B>] [(digits)] [delim_spec] (digits [ , digits]) 
|<B>ORACLE_DATE</B>                                                    
|<B>ORACLE_NUMBER [COUNTED] </B>                                     
|<B>FLOAT [EXTERNAL] </B>[(digits)] [delim_spec] 
|<B>DOUBLE</B> 
|<B>BINARY_FLOAT [EXTERNAL] </B> [(digits)] [delim_spec]
|<B>BINARY_DOUBLE </B>                          
|<B>RAW</B> [(digits)]                                                 
|<B>CHAR</B> [(digits)] [delim_spec] [trim_spec] [date_format_spec]       
|<B>{ VARCHAR | VARRAW | VARCHARC | VARRAWC | DATE | TIMESTAMP }</B> [ ([len ,] len) ] [identifier|string_literal]
| <b>RECNUM</b>
}
</PRE>

<<init_spec>>
{
    DEFAULTIF condition
  | NULLIF    condition
}...
<<>>


<PRE date_format_spec>
[<B>DATE_FORMAT</B>]
{
<B>{ DATE 
  | TIMESTAMP [WITH [LOCAL] TIME ZONE] } MASK</B> {identifier|string_literal}  
| <B>INTERVAL { YEAR_TO_MONTH | DAY_TO_SECOND }</B>
}
</PRE>

