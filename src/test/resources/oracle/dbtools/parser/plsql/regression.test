   (
    com.oracle.bigdata.fileformat = textfile
    com.oracle.header=1
    com.fields.terminator = '|'
    
    com.oracle.bigdata.rowformat=DELIMITED
	com.oracle.bigdata.erroropt={"action":"setnull"}
	
    com.oracle.bigdata.fields: (CUST_NUM,              \
                              DESCRIPTION,           \
                              ORDER_TOTAL)
    com.overflow:   {"action":"TRUNCATE", \
                                  "col":"DESCRIPTION"}
    com.errorOpt:  [{"action":"replace", \
                     "value":"INVALID NUM", \
                     "col":["CUST_NUM","ORDER_NUM"]} , \
                                 {"action":"reject", \
                                  "col":"ORDER_TOTAL"}]    
   )
   location
('https://swiftobjectstorage.uk-london-1.oraclecloud.com/v1/adwc4pm/weather/*.csv')
  )  
REJECT LIMIT UNLIMITED;`->
