`MERGE INTO hypt_t partition (p5) t
  USING (SELECT c, mark, ch_ts, ts  FROM t_converted) t_converted
  ON (t.c = t_converted.c + 400)
  WHEN MATCHED THEN UPDATE SET t.ts = t_converted.ts
    DELETE
    WHERE (t_converted.ts > TO_TIMESTAMP_TZ('04-NOV-2007 01:30:00 EGYPT',
                                            'DD-MON-YYYY HH24:MI:SS TZR
TZD'))
  WHEN NOT MATCHED THEN INSERT (t.c, t.ts)
    VALUES (t_converted.c + 400, t_converted.ts)
    WHERE (t_converted.ts > TO_TIMESTAMP_TZ('04-NOV-2005 01:30:00 EGYPT',
                                           'DD-MON-YYYY HH24:MI:SS TZR TZD'))`
