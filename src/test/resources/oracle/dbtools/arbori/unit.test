select 1 from (
 SELECT *
   FROM 
       ORAPERF.S_PARTY T1,
       ORAPERF.S_ORG_EXT T2,
       ORAPERF.S_USER T3,
       ORAPERF.S_PARTY T4,
       ORAPERF.S_OPTY_POSTN T5,
       ORAPERF.S_OPTY_SS T6,
       ORAPERF.S_USER T7,
       ORAPERF.S_DMND_CRTN_PRG T8,
       ORAPERF.S_SALES_METHOD T9,
       ORAPERF.S_REVN T10,
       ORAPERF.S_ADDR_PER T11,
       ORAPERF.S_REVN T12,
       ORAPERF.S_CONTACT T13,
       ORAPERF.S_POSTN T14,
       ORAPERF.S_STG T15,
       ORAPERF.S_POSTN T16,
       ORAPERF.S_OPTY_POSTN T17,
       S_EVT_ACT T18,
       ORAPERF.S_SRC T21,
       T20
   WHERE
      T20.PR_DMND_CRT_PRG_ID = T8.ROW_ID (+) AND
      T21.PR_OU_ADDR_ID = T11.ROW_ID (+) AND
      T21.LAST_ACT_ID = T18.ROW_ID (+) AND
      T21.PR_DEPT_OU_ID = T2.PAR_ROW_ID (+) AND
      T21.PR_POSTN_ID = T16.PAR_ROW_ID (+) AND
      T16.PR_EMP_ID = T7.PAR_ROW_ID (+) AND
      T21.SALES_METHOD_ID = T9.ROW_ID (+) AND
      T21.CURR_STG_ID = T15.ROW_ID (+) AND
      T21.ROW_ID = T5.OPTY_ID (+) AND T5.POSITION_ID (+) = '1+120+22' AND
      T21.ROW_ID = T6.PAR_ROW_ID (+) AND
      T21.PR_OPTYPRD_ID = T10.ROW_ID (+) AND
      T21.PR_CON_ID = T4.ROW_ID (+) AND
      T21.PR_CON_ID = T13.PAR_ROW_ID (+) AND
      T21.PR_POSTN_ID = T17.POSITION_ID AND T21.ROW_ID = T17.OPTY_ID AND
      T17.POSITION_ID = T1.ROW_ID AND
      T17.POSITION_ID = T14.PAR_ROW_ID (+) AND
      T14.PR_EMP_ID = T3.PAR_ROW_ID (+) AND
      T21.SUM_REVN_ITEM_ID = T12.ROW_ID (+) AND
      T21.PR_SRC_ID = T19.ROW_ID (+) AND
      >!<
      (T21.SECURE_FLG = 'N' OR T5.OPTY_ID IS NOT NULL)
) x, (
      select 1 from a,b where a.x=b.y 
) y where x.a=y.b; 

