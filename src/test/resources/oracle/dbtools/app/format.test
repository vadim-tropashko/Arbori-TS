`create table foo.t (
  c number,
  c2 date,
  c3 timestamp as (trunc(c2, 'mm')) materialized
);

alter table tkimcsc1_2_nocomp add c46 varchar2(1789 char) generated always as
(substr (to_char(c36),1,1789)) virtual;

ALTER TABLE emp2 ADD (income AS (salary + (salary*commission_pct)));

ALTER TABLE tbl ADD (new_hash_column AS (STANDARD_HASH(column)));`
->
`CREATE TABLE foo.t (
    c  NUMBER,
    c2 DATE,
    c3 TIMESTAMP AS ( trunc(c2, 'mm') ) MATERIALIZED
);

ALTER TABLE tkimcsc1_2_nocomp ADD
    c46 VARCHAR2(1789 CHAR) GENERATED ALWAYS AS ( substr(
        to_char(c36),
        1,
        1789
    ) ) VIRTUAL;

ALTER TABLE emp2 ADD (
    income AS ( salary + ( salary * commission_pct ) )
);

ALTER TABLE tbl ADD (
    new_hash_column AS ( standard_hash(column) )
);`
;

