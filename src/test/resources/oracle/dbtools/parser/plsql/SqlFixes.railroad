/******** MLE ********/

<< create_mle_env >>
CREATE [ OR REPLACE ] MLE ENV [ IF NOT EXISTS ]
[schema.] name
{ [ CLONE [schema.] environment_name ] |
{ [ IMPORTS (mle_import_module1 [ ,mle_import_module1] ... )]
[ LANGUAGE OPTIONS string_literal ] } };
<<>>

<< drop_mle_env >>
DROP MLE ENV [ IF EXISTS ] [schema.] name;
<<>>

<< alter_mle_env >>
ALTER MLE ENV [ IF EXISTS ] [schema.] name
{ADD IMPORTS (mle_import_module1 [ , mle_import_module1]...)
| DROP IMPORTS (import_name[ , import_name]...)
| ALTER IMPORTS (mle_import_module1 [ , mle_import_module1]...)
| SET LANGUAGE OPTIONS string_literal
| COMPILE };
<<>>

<<import_name>>
    identifier
  | string_literal
<<>>  

<<mle_import_module1>>
import_name MODULE [schema.] mle_module_name
<<>>

<< create_mle_module >>
CREATE [ OR REPLACE ] MLE MODULE [ IF NOT EXISTS ]
[schema.] name
LANGUAGE [schema.] identifier
[ VERSION string_literal ]
{USING
{BFILE(directory_name,file_name) |
{CLOB|BLOB|BFILE} {( select ) | select } } |
AS javascript}
<<>>

<< drop_mle_module >>
DROP MLE MODULE [ IF EXISTS ] [schema.] name
<<>>

<< alter_mle_module >>
ALTER MLE MODULE [ IF EXISTS ] [schema.] name 
{   
    SET METADATA 
	{ 
	  json
	| USING CLOB [ ( [mle_CLOB] ) | mle_CLOB ] 
	} 
| 
    COMPILE
}
<<>>

<< mle_CLOB >>
  SELECT JSON(string_literal)
| SELECT string_literal
| string_literal
<<>>

