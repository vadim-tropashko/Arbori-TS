`set serveroutput on
spool install_options.tmp
declare
   procedure print (in_line in varchar2) is
   begin
      dbms_output.put_line(in_line);
   end print;
begin
   print('Hello World');
end;
/ `
->
`set serveroutput on
spool install_options.tmp

DECLARE
    PROCEDURE print (
        in_line IN VARCHAR2
    ) IS
    BEGIN
        dbms_output.put_line(in_line);
    END print;

BEGIN
    print('Hello World');
END;
/`
;

