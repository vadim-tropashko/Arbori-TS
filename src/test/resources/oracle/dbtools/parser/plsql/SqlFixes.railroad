<PRE hive>
{hkey {=|:} hvalue}...
</PRE>

<PRE hkey> 
     identifier [. identifier]...
</PRE>

<PRE hvalue>{ 
     identifier [identifier| . identifier ]... | digits | string_literal   -- expr  
   | <b>ALL</b>
   | <b>[</b>  "content_list"  <b>]</b>    -- json content
   | <b>{</b>  "content_list"  <b>}</b>
   | <b>(</b>  "content_list"  <b>)</b>
   | <b>[</b>  "content_list" , <b>]</b>    -- json content
   | <b>{</b>  "content_list" , <b>}</b>
   | <b>(</b>  "content_list" , <b>)</b>
}</PRE>

<PRE "content_list">
{content|hvalue|hive} [, [<b>\</b>] {content|hvalue|hive}]...
</PRE>  

   
<PRE dml_table_expression_clause>
{ [ schema. ]
  { table
    [ partition_extension_clause
    | partition_extension_clause <b>MOVE TO</b> partition_extension_clause   -- lrgdbconapa10d:
                                                              -- update  "ONLNTEST"."ORDER_ITEMS_CHD2" 
                                                              -- partition (dataobj_to_partition( "ONLNTEST"."ORDERS_PAR2" , :1)) 
                                                              -- move to partition (dataobj_to_partition( "ONLNTEST"."ORDERS_PAR2" , :1)) 
                                                              -- set "ORDER_ID" = "ORDER_ID" where "ORDER_ID" = :1    
    | @ dblink
    ]
  |  view [ @ dblink ] 
  }
| ( subquery [ subquery_restriction_clause ] )
| table_collection_expression
}</PRE>

<PRE out_of_line_REF_constraint>  
  out_of_line_ref_constraint
</PRE>
<PRE out_of_line_ref_constraint>  --> pretty sure nobody in the world using it; simplified
{ <B>SCOPE FOR</B> (identifier)
    <b>IS</b> { [ schema. ] identifier | <b>OID</b> string_literal [identifier(identifier)] }
| <B>REF</B> (id_or_qualid) <B>WITH ROWID</B>
| <B>REF</B> (id_or_qualid) <B>ALLOW PRIMARY KEY</B>
| [ <B>CONSTRAINT</B> identifier ] <B>FOREIGN KEY</B>

    ( identifier ) references_clause
    [ constraint_state ]
}</PRE>

