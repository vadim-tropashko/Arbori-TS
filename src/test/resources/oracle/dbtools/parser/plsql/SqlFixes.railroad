identifier in_out_nocopy {datatype|<B>NATURAL</B>} [{<B>DEFAULT</B>|:= } expr]
</PRE>

<PRE in_out_nocopy>
 [<B>IN</B> | <B>OUT</B> | <B>NOCOPY</B>]...
</PRE>

<pre return_clause> 
    <B>RETURN</B> 
  [datatype  [{ <B>IS | AS</B> } call_specification]] -- once at most
  [ 
    <B>DETERMINISTIC</B>
  | <B>DETERMINISTIC PARALLEL_ENABLE</B>
  | self_as_result
  | <B>WITH CONTEXT PARAMETERS</B> ( context_params )
  ]... 
  -- undefined:| sqlj_object_type_sig 
</pre>

<pre context_params>
     identifier
   | identifier identifier
   | identifier identifier identifier
   | context_params , identifier
   | context_params , identifier identifier
   | context_params , identifier identifier identifier
</pre> 



<PRE constructor_spec>                   --> missing
  <B>[ FINAL ] [ INSTANTIABLE ]
CONSTRUCTOR FUNCTION</B> datatype
[ ([ <B>SELF IN OUT</B> datatype, ]
   identifier datatype [, identifier datatype ]...
  )
]
<B>RETURN</B> self_as_result
[ <B>{ IS | AS }</B> call_specification ]
</PRE>

<PRE self_as_result>
<B>SELF AS RESULT</B>
</PRE> 

<pre index_attributes>
[ { physical_attributes_clause
  | logging_clause
  | <b>ONLINE</b>
  | <b> [GLOBAL] TABLESPACE [SET]</b> { tablespace | <b>DEFAULT</b> }
  | index_compression
  | { <b>SORT</b> | <b>NOSORT</b> }
  | <b>REVERSE</b>
  | <b>VISIBLE</b> | <b>INVISIBLE</b>
  | partial_index_clause
  | parallel_clause
  | <B>COMPUTE STATISTICS</B>    -- Discovered in DDL for "SYS"."SQLOBJ$PLAN" 
  | <B>GLOBAL</B>
  | <B>FILTER BY</B> column
  }...
]
</pre>

<PRE create_index>  {      
  <B>CREATE</B> [ <B>UNIQUE</B> ] [ <B>BITMAP</B> | <B>MULTIVALUE</B> ] <B>INDEX [IF NOT EXISTS] </B> [ schema. ] identifier [ index_ilm_clause ]
  <B>ON</B> { cluster_index_clause
     | table_index_clause
     | bitmap_join_index_clause
     | graph_table
     }
   [ <B>USABLE |  UNUSABLE | UNRECOVERABLE | COMPUTE STATISTICS | LOCAL </B> 
   | { <B>DEFERRED</B> | <B>IMMEDIATE</B> } <B>INVALIDATION</B> 
   ]...
| -- oracle text
 <B>CREATE SEARCH INDEX [IF NOT EXISTS]</B> [schema.]identifier <B>ON</B> [schema.]identifier(identifier)
  [<B>ONLINE</B>]
  [<B>FILTER BY</B> identifier[, identifier]...]
  [<B>ORDER BY</B> identifier[<B>DESC</B>|<B>ASC</B>][, identifier[<B>DESC</B>|<B>ASC</B>]]...]
  [<B>LOCAL</B> [<B>PARTITION</B> [identifier] ]
  [, <B>PARTITION</B> [identifier] ])]
  [<B>PARAMETERS</B>(string_literal)] [<B>PARALLEL</B> digits] [<B>UNUSABLE</B>]
| -- same as above for JSON on the same page of oracle text reference
  <B>CREATE SEARCH INDEX [IF NOT EXISTS]</B> [schema.]identifier <B>ON</B> [schema.]identifier(identifier) <B>FOR {JSON | XML}</B> 
  [<b>LOCAL</b>]
   [<B>PARAMETERS</B>( string_literal
              /*[DATAGUIDE ON [CHANGE (ADD_VC | function_name)] | OFF]
  [STORAGE storage_pref]
  [SEARCH_ON (NONE | TEXT | TEXT_VALUE[(data_types)] | VALUE[(data_types)] | TEXT_VALUE_STRING)]
  [MEMORY memsize]
  [SYNC (MANUAL | EVERY "interval-string" | ON COMMIT)]
  [MAINTENANCE AUTO | MAINTENANCE MANUAL]
  [OPTIMIZE (MANUAL | EVERY "interval-string" | AUTO_DAILY)]*/
  )]
  [<b>LOCAL</b>              
  |<b>PARALLEL</b> integer
  |<b>UNUSABLE</b>]...
} [annotations_clause]  
</PRE>

  

<pre reference_partitioning>
<b>PARTITION BY REFERENCE</b> ( constraint ) 
  [ (reference_partition_desc [, reference_partition_desc]...) ]
</pre>

<pre individual_hash_partitions>       
( 
  <b>PARTITION</b> [partition] [indexing_clause] [deferred_segment_creation] [partitioning_storage_clause] [subpartitions_in_paren]     
  [, <b>PARTITION</b> [partition] [indexing_clause] [deferred_segment_creation] [partitioning_storage_clause] [subpartitions_in_paren] ]... )
</pre>

<pre subpartitions_in_paren>
( list_subpartition_desc [, list_subpartition_desc]... )
|
( range_subpartition_desc [, range_subpartition_desc]... )
</pre>

<pre update_all_indexes_clause>
<b>UPDATE INDEXES</b>
   [ ( {index_part_subpart_refactored
       [, index_part_subpart_refactored ]...
       | identifier <b>LOCAL</b>}
   ) ]    --> missing ]
</pre>

<pre index_part_subpart_refactored>
 identifier ( 
       {update_index_partition | update_index_subpartition}
 )
</pre>

<PRE subpartition_extended_name>
<B>SUBPARTITION</B> subpartition
| 
<B>SUBPARTITION FOR</b> ( subpartition_value [, subpartition_value]... )
</PRE>


<PRE split_table_partition>
<B>SPLIT</b> partition_extended_name
  { <b>AT</b> (expr [, expr]... )
    [ <b>INTO</b> ( range_partition_desc [, range_partition_desc ]... ) ]
  | <b>VALUES</b> (literal [, literal] ... )
    [ <b>INTO</b> (list_partition_desc [, list_partition_desc ]... ) ]
  | <b>INTO</b> ( { range_partition_desc [, range_partition_desc ]...
           | list_partition_desc [, list_partition_desc ]... }
         [, partition_spec] )   
  } 
[ split_nested_table_part 
| filter_condition 
| dependent_tables_clause 
| update_index_clauses 
| parallel_clause 
| allow_disallow_clustering 
| <b>ONLINE</b> 
]...
</PRE>


<PRE range_partition_desc>
<b>PARTITION</b> [partition]
[range_values_clause | range_partitions_clause_1]... 
table_partition_description
[ ( { range_subpartition_desc [, range_subpartition_desc] ...
    | list_subpartition_desc [, list_subpartition_desc] ...
    | individual_hash_subparts [, individual_hash_subparts] ...
    } [ <b>CREATION DEFERRED</b> ]
  ) | hash_subparts_by_quantity ]
  [ <b>STORE IN</b> ( tablespace [, tablespace]...) ]      -- 33894860
</PRE>  

<pre model_column_clauses>
[ <b>PARTITION BY</b> ("expr[c_alias]" ["{,expr[c_alias]}..."]) ]  
  <b>DIMENSION BY</b> ("expr[c_alias]" ["{,expr[c_alias]}..."])
  <b>MEASURES</b>     ("expr[c_alias]" ["{,expr[c_alias]}..."])
</pre>

<pre "expr[c_alias]">
expr [c_alias]
</pre>

<pre "{,expr[c_alias]}...">
{, "expr[c_alias]" }...
</pre>


<pre update_index_partition>
index_partition_description
     [ index_subpartition_clause ]
[, index_partition_description
      [ index_subpartition_clause ] ]...    
</pre>

<pre modify_table_subpartition>
<b>MODIFY</b> subpartition_extended_name
{ allocate_extent_clause 
| deallocate_unused_clause   --> was: _cluse
| shrink_clause
| { { <b>LOB</b> LOB_item | <b>VARRAY</b> varray } (modify_LOB_parameters) }...
| [ <b>REBUILD</b> ] <b>UNUSABLE LOCAL INDEXES</b>
| { <b>ADD</b> | <b>DROP</b> } <b>VALUES</b> ( literal [, literal]... )
}
</pre>

<PRE expression_list>
{ "expr_list"
| ( "expr_list" )        
| ( )  
}
</PRE>

<<"expr|Dexpr|condition">>
    expr 
  | <b>DISTINCT</b> expr
  |  expr <b>DETERMINISTIC</b>
  | condition
<<>>


<PRE "expr_list">
{   "expr|Dexpr|condition"
  | "expr_list" , "expr|Dexpr|condition"
}
</PRE>


<pre model_expression>
{ measure_column <b>[</b> "cond_or_expr"[ , "cond_or_expr" ]... <b>]</b> --> was "}...]"
| { aggregate_function | function_call }
	{ <b>[</b> "cond_or_expr"[ , "cond_or_expr" ]... <b>]</b>  --> ditto
        | <b>[</b> single_column_for_loop [, single_column_for_loop] ... <b>]</b>

	| <b>[</b> multi_column_for_loop <b>]</b>
        }
| analytic_function
}
</pre>

<pre "cond_or_expr"> 
--{ condition | expr }
{ comparison_condition | model_condition | expr 
| like_condition | in_condition | null_condition
}
</pre>

<pre expr_as_alias_>        --> introduced to simplify pivot_in_clause
{ expr                      --> which, before the fix, allowed "expr expr expr" chain
         | ( "expr_list" )
         } [ as_alias]
</pre>

<pre pivot_in_clause>
<b>IN</b> ( { expr_as_alias_ [, expr_as_alias_]...
     | subquery
     | <b>ANY</b> [, <b>ANY</b>]...
     }
   )
|  <b>IN</b> ()  
</pre>


<PRE index_org_table_clause>   --> index org rule is a mess; rewriting completely to fix example
{
