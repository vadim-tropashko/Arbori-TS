             ledger_d t301
        INNER JOIN (
                 gl_code_combination_d t229
            INNER JOIN (
                     fiscal_day_d t1343
                INNER JOIN (
                         party_d t7439
                    INNER JOIN (
                             internal_org_d t7447
                        INNER JOIN (
                                 fiscal_day_d t24059
                            INNER JOIN (
                                     code_values_lkp_tl t25919
                                INNER JOIN (
                                         code_values_lkp_tl t25438
                                    INNER JOIN ap_sla_expense_dist_cf t59301 ON t25438.language = 'US'
                                ) ON t25919.code = t59301.invoice_type_code
