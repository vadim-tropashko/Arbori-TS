`SELECT 1
FROM            
NATURAL_ACCOUNT_D T16306 /* NATURAL_ACCOUNT_D_Base */  inner join (
     LEDGER_D T301 /* LEDGER_D */  inner join (
          GL_CODE_COMBINATION_D T229 /* GL_CODE_COMBINATION_D */  inner join (
               FISCAL_DAY_D T1343 /* FISCAL_DAY_D */  inner join (
                    PARTY_D T7439 /* PARTY_D_SUPPLIER */  inner join (
                         INTERNAL_ORG_D T7447 /* INTERNAL_ORG_D_Payables_Org */  inner join (
                              FISCAL_DAY_D T24059 /* FISCAL_DAY_D_InvoiceDate_Fiscal_Calendar */  inner join (
                                   CODE_VALUES_LKP_TL T25919 /* CODE_VALUES_LKP_TL_AP_Transaction_Type */  inner join (
                                        CODE_VALUES_LKP_TL T25438 /* CODE_VALUES_LKP_TL_AP_Source */  
                                        inner join AP_SLA_EXPENSE_DIST_CF T59301 /* Fact_AP_SLA_EXPENSE_DIST_CF */  
                                        On T25438.LANGUAGE = 'US' ) 
                                   On T25919.CODE = T59301.INVOICE_TYPE_CODE ) 
                              On T24059.FISCAL_DAY_DATE = T59301.INVOICED_ON_DATE ) 
                          On T7447.ORGANIZATION_ID = T59301.PAYABLES_BU_ID) 
                     On T7439.PARTY_ID = T59301.SUPPLIER_PARTY_ID) On T1343.ADJUSTMENT_PERIOD_FLAG = 'N'  ) 
                On T229.CODE_COMBINATION_ID = T59301.GL_CODE_COMBINATION_ID) On T301.LEDGER_ID = T59301.XLA_LEDGER_ID) 
           On T16306.NATURAL_ACCOUNT_SEGMENT = T59301.NATURAL_ACCOUNT_SEGMENT;`
->
`SELECT
    1
FROM
         natural_account_d t16306 /* NATURAL_ACCOUNT_D_Base */
    INNER JOIN (
             ledger_d t301 /* LEDGER_D */
        INNER JOIN (
                 gl_code_combination_d t229 /* GL_CODE_COMBINATION_D */
            INNER JOIN (
                     fiscal_day_d t1343 /* FISCAL_DAY_D */
                INNER JOIN (
                         party_d t7439 /* PARTY_D_SUPPLIER */
                    INNER JOIN (
                             internal_org_d t7447 /* INTERNAL_ORG_D_Payables_Org */
                        INNER JOIN (
                                 fiscal_day_d t24059 /* FISCAL_DAY_D_InvoiceDate_Fiscal_Calendar */
                            INNER JOIN (
                                     code_values_lkp_tl t25919 /* CODE_VALUES_LKP_TL_AP_Transaction_Type */
                                INNER JOIN (
                                         code_values_lkp_tl t25438 /* CODE_VALUES_LKP_TL_AP_Source */
                                    INNER JOIN ap_sla_expense_dist_cf t59301 /* Fact_AP_SLA_EXPENSE_DIST_CF */ ON t25438.language = 'US'
                                ) ON t25919.code = t59301.invoice_type_code
                            ) ON t24059.fiscal_day_date = t59301.invoiced_on_date
                        ) ON t7447.organization_id = t59301.payables_bu_id
                    ) ON t7439.party_id = t59301.supplier_party_id
                ) ON t1343.adjustment_period_flag = 'N'
            ) ON t229.code_combination_id = t59301.gl_code_combination_id
        ) ON t301.ledger_id = t59301.xla_ledger_id
    ) ON t16306.natural_account_segment = t59301.natural_account_segment;`
;

