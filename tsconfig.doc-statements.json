{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist/doc-statements",
    "strict": false,
    "noCheck": true,
    "noImplicitOverride": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/test/typescript/oracle/dbtools/parser/plsql/DocStatementsTest.ts",
    "src/test/typescript/oracle/dbtools/app/SqlInsightTest.ts"
  ]
}
