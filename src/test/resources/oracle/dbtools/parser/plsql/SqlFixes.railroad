            identifier
          | <b>lbr</b>  
          | <b>rbr</b>  
          | <b>lcp</b>  
          | <b>rcp</b>  
          | <b>sbar</b>   
          -- redundant and wont work: | <b>dbar</b>   
          | <b>lt</b>  
          | <b>gt</b> 
          | ;
          | (
          | )
          | =
}
</pre>
*/

<pre drop_disk_clause>
<b>DROP</b>
{ [<b>QUORUM</b> |<b>REGULAR</b>] <b>DISK</b>
    disk_name [ <b>FORCE</b> | <b>NOFORCE</b> ]
    [, disk_name [ <b>FORCE</b> | <b>NOFORCE</b> ] ]...
| disks_in_clause [ <b>FORCE</b> | <b>NOFORCE</b> ]
    [, failgroup_name [ <b>FORCE</b> | <b>NOFORCE</b> ] ]...
}
</pre>

<pre disk_online_clause>
<b>ONLINE</b>
  { { [<b>QUORUM</b> |<b>REGULAR</b>] <b>DISK</b> disk_name [, disk_name]...
    | disks_in_clause
    } ...
  | <b>ALL</b>
  } [ <b>POWER</b> integer ] [ <b>WAIT | NOWAIT</b> ]
</pre>

<pre disk_offline_clause> 
<b>OFFLINE</b>
  { [<b>QUORUM</b> |<b>REGULAR</b>] <b>DISK</b> disk_name [, disk_name ] ...
  | disks_in_clause
  } ... [timeout_clause]
</pre>

<pre resize_disk_clause>
<b>RESIZE</b>
{ <b>ALL</b> [ <b>SIZE</b> size_clause ]
| [<b>QUORUM | REGULAR</b>] <b>DISK</b>
   disk_name [ <b>SIZE</b> size_clause ]
   [, disk_name [ <b>SIZE</b> size_clause ] ]...
| disks_in_clause [ <b>SIZE</b> size_clause ]
    [, failgroup_name [ <b>SIZE</b> size_clause ] ]...
}
</pre>


<pre disks_in_clause> -- refactored
    <b>DISKS IN</b> [<b>QUORUM | REGULAR</b>] <b>FAILGROUP</b> failgroup_name [, failgroup_name]... -- misplaced <b>&</b>, unbalanced [
</pre>

<pre check_diskgroup_clause>
<b>CHECK</b> [<b>ALL</b>] [ <b>REPAIR</b> | <b>NOREPAIR</b> ]
</pre>

<pre qualified_template_clause>
<b>ATTRIBUTES</b>  -- was: ATTRIBUTE
( redundancy_clause 
  striping_clause 
  -- no longer in 21c grammaar: disk_region_clause
)
</pre>

<pre create_materialized_vw_log>
<b>CREATE {MATERIALIZED VIEW [IF NOT EXISTS]|SNAPSHOT} LOG ON</b> [ schema. ] table
  [ physical_attributes_clause
  | <b>TABLESPACE</b> tablespace
  | logging_clause
  | { <b>CACHE</b> | <b>NOCACHE</b> }
  ]...
  [ parallel_clause ]
  [ table_partitioning_clauses ]
  [ <b>WITH</b> 
          -- 2 problematic examples: statements_6002.htm#SQLRF54189
          -- http://st-doc.us.oracle.com/database/121/SQLRF/statements_6003.htm#SQLRF54227
         "mv_log_details"
         [, "mv_log_details"]...      
    [ new_values_clause ]
  ] [ mv_log_purge_clause ] [ for_refresh_clause ]
</pre>

<pre "mv_log_details">
        [ <b>OBJECT ID</b>
         | <b>PRIMARY KEY</b>
         | <b>ROWID</b>
         | <b>SEQUENCE</b>
         | <b>COMMIT SCN</b>
        ] [(column [, column ]...)]
</pre>

<pre level_clause>
<b>LEVEL</b> level <b>IS</b>
   { level_table.level_column
   | (level_table.level_column
      [, level_table.level_column ]...
     )
   }
   [<b>SKIP WHEN NULL</b>] -- missing
</pre>

<pre object_action>{
   object_privilege
}</pre>
<pre system_action>
     [<b>ADD</b>] system_privilege
   | [<b>DROP</b>] system_privilege
   | {<b>AUDIT | GRANT | READ | WRITE | EXECUTE</b>} {<b>DIRECTORY | TABLE | VIEW | PROCEDURE | PACKAGE</b>}
</pre>

<pre standard_actions>
<b>ACTIONS</b>
  { { object_action | <b>ALL</b> }
    <b>ON</b> { <b>DIRECTORY</b> directory_name
       | <b>MINING MODEL</b> [ schema. ] object_name
       | [ schema. ] object_name }
  | { system_action | <b>ALL</b> }
  }
    [ ,{ --<-- missing comma
      { object_action | <b>ALL</b> }
      <b>ON</b> { <b>DIRECTORY</b> directory_name
         | <b>MINING MODEL</b> [ schema. ] object_name
         | [ schema. ] object_name }
    | { system_action | <b>ALL</b> } } ]...
</pre>

<pre component_action>identifier | <b>ALL</b></pre>

<pre analyze>
<b>ANALYZE</b>
  { { <b>TABLE</b> [ schema. ] table
    | <b>INDEX</b> [ schema. ] index
    } [ partition_extension_clause ]
  | <b>CLUSTER</b> [ schema. ] cluster
  }
  { validation_clauses
  | <b>LIST CHAINED ROWS</b> [ into_clause ]
  --| {<b>DELETE | COMPUTE | ESTIMATE</b>} [ <b>SYSTEM</b> ] <b>STATISTICS [FOR ALL INDEXES]</b> 
  | estimate_statistics  -- exists in 12c deprecated in 21c?
  } ;
|
 <b>VALIDATE INDEX</b> [ schema. ] index ;
</pre>

<pre estimate_statistics>
--<b>ESTIMATE</b> [ <b>SYSTEM</b> ] <b>STATISTICS</b> 
{<b>DELETE | COMPUTE | ESTIMATE</b>} [ <b>SYSTEM</b> ] <b>STATISTICS</b>
[ for_statistics_clause 
| <b>SAMPLE</b> integer { <b>ROWS</b> | <b>PERCENT</b> } ]...
</pre>

<pre for_statistics_clause>   
<b>FOR</b>
   { <b>TABLE</b>
   | <b>ALL</b> [ <b>INDEXED</b> ] <b>COLUMNS</b> [ <b>SIZE</b> integer ]
   | <b>COLUMNS</b> [ <b>SIZE</b> integer ]
     { column | attribute } [ SIZE integer ]
       [ { column | attribute }
         [ <b>SIZE</b> integer ]
       ]...
   | <b>ALL</b> [ <b>LOCAL</b> ] <b>INDEXES</b>
   }
   [ <b>FOR</b>
    { <b>TABLE</b>
    | <b>ALL</b> [ <b>INDEXED</b> ] <b>COLUMNS</b>
         [ <b>SIZE</b> integer ]
    | <b>COLUMNS</b> [ <b>SIZE</b> integer ]
      { column | attribute } [ <b>SIZE</b> integer ]
        [ { column | attribute }
          [ <b>SIZE</b> integer ]
        ]...
    | <b>ALL</b> [ <b>LOCAL</b> ] <b>INDEXES</b>
    }
   ]...
</pre>


<pre validation_clauses>
{ <b>VALIDATE REF UPDATE</b> [ <b>SET DANGLING TO NULL</b> ]
| <b>VALIDATE STRUCTURE</b>
     [ <b>CASCADE</b> ]  -- made CASCADE optional to fix statements_4005.htm#SQLRF53687:
						  -- ANALYZE TABLE employees VALIDATE STRUCTURE CASCADE;
     [ <b>FAST</b> | <b>COMPLETE</b> ] -- statements_4005.htm#SQLRF53687
     [{ <b>OFFLINE</b> | <b>ONLINE</b> } [ into_clause ]  ]
}
</pre>

<pre create_controlfile> -- doesn't parse statements_5004.htm#SQLRF53839 
<b>CREATE CONTROLFILE  [IF NOT EXISTS]</b>
  [ <b>REUSE</b> ] [ <b>SET</b> ] <b>DATABASE</b> database
  [ {<b>RESETLOGS</b> | <b>NORESETLOGS</b>} 
  | <b>MAXLOGFILES</b> integer     
  | <b>MAXLOGMEMBERS</b> integer
  | <b>MAXLOGHISTORY</b> integer
  | <b>MAXDATAFILES</b> integer
  | <b>MAXINSTANCES</b> integer
  | { <b>ARCHIVELOG</b> | <b>NOARCHIVELOG</b> }
  | <b>FORCE</b> <b>LOGGING</b>
  | logfile_clause 
  |<B>#</b> <b>STANDBY LOGFILE</b> -- added
  | <b>DATAFILE</b> file_specification
             [, file_specification ]... 
  | character_set_clause 
  ]... 
</pre>

<pre unified_audit>
<b>AUDIT</b> 
  { <b>POLICY</b> policy
    [ { <b>BY</b> user [, user]... } | { <b>EXCEPT</b> user [, user]... } ]
    [ <b>WHENEVER</b> [ <b>NOT</b> ] <b>SUCCESSFUL</b> ]
  --}   statements_4008.htm#SQLRF56427 
  |
  --{ 
  <b>CONTEXT</b> <b>NAMESPACE</b> namespace <b>ATTRIBUTES</b> attribute [, attribute ]...
      [, <b>CONTEXT</b> <b>NAMESPACE</b> namespace <b>ATTRIBUTES</b> attribute [, attribute ]... ]...
    [ <b>BY</b> user [, user]... ]
  } 
;
</pre>

<pre interval_expr> -- truncated interval_literal
    string_literal interval_literal_qualifier
    | 
    expr
</pre>

<pre cluster_details>
<b>CLUSTER_DETAILS</b> ( [ schema . ] model 
        [ , cluster_id [ , expr] ] [<b>DESC | ASC | ABS </b>]  -- <b></b>
        mining_attribute_clause )
</pre>

<pre cluster_details_analytic>
<b>CLUSTER_DETAILS</b> mining_analytic_body
</pre>

<pre cluster_distance_analytic>
<b>CLUSTER_DISTANCE</b> mining_analytic_body
</pre>

<pre feature_id_analytic>
<b>FEATURE_ID</b> mining_analytic_body
</pre>

<pre feature_value_analytic>
<b>FEATURE_VALUE</b> mining_analytic_body
</pre>

<pre feature_details_analytic>
<b>FEATURE_DETAILS</b> mining_analytic_body
</pre>


<pre mining_analytic_body> 
( <b>INTO</b> expr
        [ , cluster_id [ , expr ] ] [ <b>DESC | ASC | ABS</b> ] -- <b></b>
        mining_attribute_clause )
        <b>OVER</b> 
{        
  ( mining_analytic_clause )
|
    mining_analytic_clause 
}
</pre>        


<pre cluster_id_analytic>
<b>CLUSTER_ID</b>  mining_analytic_body
</pre>

<pre cluster_id1> -- name conflict
<b>CLUSTER_ID</b> ( [ schema . ] model mining_attribute_clause )
</pre>


<pre create_indextype>
<b>CREATE</b> [ <b>OR REPLACE</b> ] <b>INDEXTYPE  [IF NOT EXISTS]</b> [ schema. ] indextype
  <b>FOR</b> [ schema. ] operator (parameter_type [, parameter_type ]...) -- typo 
        [ [<b>REWRITE JOIN</b>],  [ schema. ] operator (parameter_type [, parameter_type ]...)
        ]...
  using_type_clause
  [ <b>WITH LOCAL [RANGE] PARTITION</b>
  | <b>WITH COMPOSITE INDEX</b> 
  | <b>WITHOUT COLUMN DATA</b>
  | <b>WITH ARRAY DML</b> [(parameter_type [, parameter_type ]...)]
  | <b>WITH REBUILD ONLINE</b>
  | <b>WITH ORDER BY</b> column [(datatype)] 
  ]...
  [ storage_table_clause ]
</pre>

<pre alter_database_link>
<b>ALTER [SHARED] [PUBLIC] DATABASE LINK [IF EXISTS]</b> dblink  -- missing [SHARED] [PUBLIC]
  { "db_link_auth" [ dblink_authentication ]
  | dblink_authentication
  }
</pre>

/* more general in create_database_link 
<pre "db_link_auth">  
<b>CONNECT TO</b> user <b>IDENTIFIED BY</b> password
</pre>
*/

<pre json_query>
<b>JSON_QUERY</b>
  ( expr [ <b>FORMAT JSON</b> ], JSON_basic_path_expression
    [ JSON_passing_clause 
    | JSON_query_returning_clause  
    | JSON_query_wrapper_clause 
    | JSON_query_quotes_clause   
    | JSON_query_on_error_clause 
    | JSON_query_on_empty_clause 
    | JSON_query_on_mismatch_clause 
    | <b>{KEEP|OMIT} QUOTES [ON SCALAR STRING]</b> 
    | inline_constraint
    | type_strict_lax
    ]...
  )
</pre>

<pre JSON_basic_path_expression>
   identifier
 | string_literal
 | string_literal identifier 
 | string_literal JSON_query_returning_clause  identifier
 | <b>STREAM</b> string_literal
</pre> 

<pre JSON_passing_clause>
<b>PASSING</b> expr <b>AS</b> identifier
</pre>

<pre JSON_table_on_error_clause>
{<b>DEFAULT</b> expr|<b>NULL</b>|<b>ERROR</b>}  <b>ON ERROR</b>
</pre>

<pre JSON_table_on_empty_clause>
{<b>DEFAULT</b> expr|<b>NULL|ERROR|PRESENT</b>}  <b>ON EMPTY</b>
</pre>


<pre JSON_query_returning_clause>
[ <b>RETURNING</b> JSON_value_return_type ] <b>[ {ALLOW | DISALLOW} SCALARS ] [ PRETTY ] [ ASCII ]</b>
</pre>

<pre JSON_columns_clause>
<b>COLUMNS</b> ( JSON_column_definition [, JSON_column_definition ]... )
|
<b>COLUMNS</b>  JSON_column_definition [, JSON_column_definition ]... 
</pre>

<pre json_value>
<b>JSON_VALUE</b>
  ( expr [ format_clause ], JSON_basic_path_expression 
    [ json_value_on__ ]...
    [ type_strict_lax ]
  )
</pre>

<pre json_value_on__>
      JSON_value_returning_clause 
    | JSON_value_on_error_clause 
    | JSON_value_on_empty_clause 
    | JSON_value_on_mismatch_clause
    | JSON_passing_clause 
    | allow_boolean_number_conversion    
</pre>


<pre JSON_value_on_mismatch_clause>
<b> {
   { IGNORE | ERROR | NULL }
    ON MISMATCH 
   [( {MISSING DATA | EXTRA DATA | TYPE ERROR} 
      [ , {MISSING DATA | EXTRA DATA | TYPE ERROR}  ]... )]
  } ...
  </b>
</pre>  


<pre JSON_value_return_type>
    [<b>NATIONAL</b>] 
    {<b>VARCHAR2|VARCHAR|NVARCHAR2|NVARCHAR|CHAR|CHARACTER</b>} 
    [ ( size [<b>BYTE | CHAR</b>] ) | <b>VARYING</b> [ (size) ] ]
    [ <b>ASCII</b> ][ <b>TRUNCATE|PRETTY</b> ] 
| <b>CLOB</b> 
| <b>BLOB</b>
| <b>NUMBER</b> [ ( precision [, scale] ) ] [<b>DEFAULT</b> expr <b>ON ERROR</b>]
| <b>NUMBER</b> [ ( precision [, scale] ) ] [<b>DISALLOW BOOL TO NUMBER</b>]
| <b>NUMBER ORDERED</b>
| <b>INTEGER</b>
| <b>DATE [ { TRUNCATE | PRESERVE } TIME ]</b>
| <b>TIMESTAMP</b>
| <b>TIMESTAMP WITH TIME ZONE</b>
| <b>TIMESTAMP WITH LOCAL TIME ZONE</b>
| <b>INTERVAL YEAR TO MONTH</b>
| <b>INTERVAL DAY TO SECOND</b>
| <b>RAW</b> [ ( precision [, scale] ) ] [<b>WITH TYPENAME</b>]
| <b>SDO_GEOMETRY [WITH VALIDATION]</b> 
| <b>JSON</b>
| <b>ASCII</b>
| allow_boolean_number_conversion
| <b> BOOLEAN [ TYPE ( STRICT ) ]  </b>
| [<b>ANY</b>] JSON_value_return_object_instance
| vector_type --vector_function?
</pre>

<pre allow_boolean_number_conversion>
<b> {ALLOW | DISALLOW} [ BOOLEAN | BOOL ] TO NUMBER [CONVERSION]  </b>
</pre>

<pre create_sequence>
<b>CREATE SEQUENCE [IF NOT EXISTS]</b> [ schema. ] sequence
  [ <b>SHARING</b> = { <b>METADATA</b> | <b>DATA</b> | <b>NONE</b> } ]
  [ { <b>INCREMENT BY</b> | <b>START WITH</b> } expr
  | { <b>MAXVALUE</b> expr | <b>NOMAXVALUE</b> }
  | { <b>MINVALUE</b> expr | <b>NOMINVALUE</b> }
  | { <b>CYCLE</b> | <b>NOCYCLE</b> }
  | { <b>CACHE</b> integer | <b>NOCACHE</b> }
  | { <b>ORDER</b> | <b>NOORDER</b> }
  | { <b>KEEP</b> | <b>NOKEEP</b> }
  | { <b>SESSION</b> | <b>GLOBAL</b> }
  | { <b>PARTITION</b> | <b>NOPARTITION</b> }  -- encountered in DDL for "SYS"."UGROUP_SEQUENCE"
  | { <b>SCALE</b> | <b>NOSCALE</b> }     -- "SYS"."AWSEQ$"
  ]...
</pre>

<pre storage_clause>
<b>STORAGE</b>
({ <b>INITIAL</b> size_clause
 | <b>NEXT</b> size_clause
 | <b>MINEXTENTS</b> integer
 | <b>MAXEXTENTS</b> { integer | <b>UNLIMITED</b> }
 | maxsize_clause
 | <b>PCTINCREASE</b> integer
 | <b>FREELISTS</b> integer
 | <b>FREELIST GROUPS</b> integer
 | <b>OPTIMAL</b> [ size_clause | <b>NULL</b> ]
 | <b>BUFFER_POOL</b> { <b>KEEP</b> | <b>RECYCLE</b> | <b>DEFAULT</b> }
 | <b>FLASH_CACHE</b> { <b>KEEP</b> | <b>NONE</b> | <b>DEFAULT</b> }
 | <b>CELL_FLASH_CACHE</b> { <b>KEEP</b> | <b>NONE</b> | <b>DEFAULT</b> } -- encountered in DDL for "SYS"."C_USER#"
 | <b>ENCRYPT</b>
 } ...
)
</pre>

<pre parallel_clause>
{ <b>NOPARALLEL</b> 
| <b>PARALLEL</b> [ integer ] 
| <b>PARALLEL</b> ( <b>DEGREE</b> integer <b>INSTANCES</b> integer ) -- encountered in DDL for "SYS"."C_USER#"
| <b>PARALLEL</b> ( <b>DEGREE</b> integer <b>INSTANCES DEFAULT</b>   ) 
| <b>PARALLEL</b> ( <b>DEGREE</b> integer ) 
| <b>PARALLEL</b> ( <b>DEGREE DEFAULT INSTANCES</b> integer )    
| <b>PARALLEL</b> ( <b>DEGREE DEFAULT INSTANCES DEFAULT</b> )    
| <b>PARALLEL</b> ( <b>DEGREE DEFAULT</b> )    
} [reject_limit_unlimited]
</pre>

<pre purge>
<b>PURGE</b> { { <b>TABLE [IF EXISTS]</b> table | <b>INDEX [IF EXISTS]</b> index }
      | { <b>RECYCLEBIN</b> | <b>DBA_RECYCLEBIN</b> | <b>USER_RECYCLEBIN</b> } 
      | <b>TABLESPACE [IF EXISTS]</b> tablespace [ <b>USER</b> username ]
      } ;
</pre>

<pre last_value>
first_last_value
</pre>
<pre first_value>
first_last_value
</pre>

<PRE any_types>
{ <b>SYS</b>.<b>AnyData</b> | <b>SYS</b>.<b>AnyType</b> | <b>SYS</b>.<b>AnyDataSet</b> }
</PRE>

<pre opt_AS>
[<b>AS</b>]
</pre>

<pre aux_xml_value_expr>
value_expr [ opt_AS { c_alias | <b>EVALNAME</b> value_expr } ]
</pre>

<pre XML_attributes_clause>
<b>XMLATTRIBUTES</b> (
  <B>[ENTITYESCAPING | NOENTITYESCAPING]
  [SCHEMACHECK | NOSCHEMACHECK]</B>
    aux_xml_value_expr -- was: value_expr [ <b>AS</b> c_alias ]
    [, aux_xml_value_expr ]...
)
</pre>


<pre xmlforest>
<b>XMLFOREST</b> ( 
    [<b>NOENTITYESCAPING</b>]
    aux_xml_value_expr
    [, aux_xml_value_expr ]...
)
</pre>

<pre application_clauses>
<b>APPLICATION</b>
{ /*{ <<<<error*/ app_name
    { <b>BEGIN INSTALL</b> string_literal [ <b>COMMENT</b> string_literal ]
    | <b>END INSTALL</b> [ string_literal ]
    | <b>BEGIN PATCH</b> number [ <b>MINIMUM VERSION</b> string_literal ] [ <b>COMMENT</b> string_literal ]
    | <b>END PATCH</b> [ number ]
    | <b>BEGIN UPGRADE</b> [string_literal] <b>TO</b> string_literal [ <b>COMMENT</b> string_literal ]
    | <b>END UPGRADE</b> [ <b>TO</b> string_literal ]
    | <b>BEGIN UNINSTALL</b>
    | <b>END UNINSTALL</b>
    | <b>SET PATCH</b> number
    | <b>SET VERSION</b> string_literal
    | <b>SET COMPATIBILITY VERSION</b> { string_literal | <b>CURRENT</b> }
    | <b>SYNC</b>  }
  |
  { <b>ALL SYNC</b> }
}
</pre>

<pre partitioning_storage_clause>
[  <b>TABLESPACE</b> tablespace 
  | <b>TABLESPACE SET</b> tablespace_set 
  | <b>OVERFLOW</b>
  | table_compression
  | key_compression
  | index_compression
  | inmemory_clause
  | ilm_clause
  | LOB_partitioning_storage
  | , LOB_partitioning_storage
  | <b>VARRAY</b> varray_item <b>STORE AS [SECUREFILE | BASICFILE] LOB</b> LOB_segname
  | JSON_storage_clause
  | <b>READ ONLY</b>
  | logging_clause
]...
</pre>

/* also defined in JSON FS:
partitioning_storage_clause ::= (( 'TABLESPACE' tablespace | 'OVERFLOW' ('TABLESPACE'
tablespace)? | table_compression | key_compression | LOB_partitioning_storage | 'VARRAY' varray_item
'STORE' 'AS' (SECUREFILE | BASICFILE)? 'LOB' LOB_segname | JSON_storage_clause )?)+
;*/



<pre type_name>
<b>
       BINARY_DOUBLE
     | BINARY_FLOAT
     | DATE
     | INTERVAL DAY TO SECOND
     | INTERVAL YEAR TO MONTH
     | NUMBER
     | TIMESTAMP
     | TIMESTAMP WITH TIME ZONE
     | TIMESTAMP WITH LOCAL TIME ZONE
</b> 
     | identifier
     | <b>TIMESTAMP</b> ( digits )
</pre>

<pre create_attribute_dimension>
<b>CREATE</b> [ <b>OR REPLACE</b> ] [ <b>FORCE</b> | <b>NOFORCE</b> ] <b>ATTRIBUTE DIMENSION [IF NOT EXISTS]</b>
  [ schema. ] identifier  
  [ sharing_clause 
  | classification_clause 
  | <b>DIMENSION TYPE</b> { <b>STANDARD</b> | <b>TIME</b> } 
  ]...
  attr_dim_using_clause
  attributes_clause
  [ attr_dim_level_clause ]...
  [ all_clause ]
</pre>


<pre classification_clause>
[ <b>CAPTION</b> /*caption*/ identifier ]
[ <b>DESCRIPTION</b> /*description*/ identifier ]
[ <b>CLASSIFICATION</b> /*classification_name*/ identifier
  [ <b>VALUE</b> /*classification_value*/ string_literal ] 
  [ <b>LANGUAGE</b> /*language*/ string_literal ]
]...
</pre>

<pre attr_dim_using_clause>
  <b>USING</b> [ schema. ] /*dim_source*/ identifier [ [ <b>AS</b> ] alias]
</pre>

<pre attributes_clause>
  <b>ATTRIBUTES</b> ( "attr_dim_attribute_clause" [, "attr_dim_attribute_clause" ]... )
</pre>

<pre "attr_dim_attribute_clause">
  [ alias. ] column [ [ <b>AS</b> ] /*attribute_name*/ identifier ] [ classification_clause ]...
</pre>

<pre attr_dim_level_clause>
<b>LEVEL</b> level [ { <b>NOT NULL</b>  |  <b>SKIP WHEN NULL</b> } ]
  [classification_clause]...
  [ <b>LEVEL TYPE</b> 
      {   <b>STANDARD</b> 
        | <b>YEARS</b> 
        | <b>HALF_YEARS</b>
        | <b>QUARTERS</b>
        | <b>MONTHS</b>
        | <b>WEEKS</b>
        | <b>DAYS</b>
        | <b>HOURS</b>
        | <b>MINUTES</b>
        | <b>SECONDS</b>
      }
  ]
  [classification_clause]...   
  key_clause [ alternate_key_clause ]
  [ <b>MEMBER NAME</b> expr ]
  [ <b>MEMBER CAPTION</b> expr ] 
  [ <b>MEMBER DESCRIPTION</b> expr ]
  [ <b>ORDER BY</b>  <b>[ MIN | MAX ]</b> dim_order_clause 
                    [, <b>[ MIN | MAX ]</b> dim_order_clause ]... 
  ]
  [ <b>DETERMINES</b> ( attribute [, attribute]... ) ]
</pre>

/*<pre classification_clause_iter>
  { classification_clause }...
</pre>*/

<pre key_clause>
<b>KEY</b> { attribute | ( attribute ) | ( attribute [, attribute]... ) }
</pre>

<pre alternate_key_clause>
<b>ALTERNATE KEY</b> { attribute | ( attribute ) 
                |  
                ( attribute [, attribute ]... )
              }
</pre>

<pre dim_order_clause>
attribute [ <b>ASC</b> | <b>DESC</b> ] [ <b>NULLS</b> { <b>FIRST</b> | <b>LAST</b> } ]
</pre>

<pre all_clause>
     <b>ALL</b> 
            { <b>MEMBER NAME</b> expr 
            | <b>MEMBER CAPTION</b> expr 
            | <b>MEMBER DESCRIPTION</b> expr 
            }...
</pre>


<pre create_hierarchy>
<b>CREATE</b> [ <b>OR REPLACE</b> ] [ <b>FORCE</b> | <b>NOFORCE</b> ] 
  <b>HIERARCHY [IF NOT EXISTS]</b> [ schema. ] /*hierarchy*/identifier
  [ sharing_clause ]
  [ classification_clause ]... --]
  hier_using_clause
  [ level_hier_clause ]
  [ hier_attrs_clause ]
</pre>


<pre hier_using_clause>
<b>USING</b> [ schema. ] /*attribute_dimension*/identifier level_hier_clause
</pre>

<pre level_hier_clause>
( /*level*/identifier [ <b>CHILD  OF</b> /*level*/identifier ]... )
</pre>

<pre hier_attrs_clause>
<b>HIERARCHICAL ATTRIBUTES</b> ( hier_attr_clause [, hier_attr_clause ]... )
</pre>

<pre hier_attr_clause>
hier_attr_name [ classification_clause ]...
</pre>

<pre hier_attr_name>
{   <b>MEMBER_NAME</b>
  | <b>MEMBER_UNIQUE_NAME</b>
  | <b>MEMBER_CAPTION</b>
  | <b>MEMBER_DESCRIPTION</b>
  | <b>LEVEL_NAME</b>
  | <b>HIER_ORDER</b>
  | <b>DEPTH</b>
  | <b>DEPTH_CHARGE</b>
  | <b>IS_LEAF</b>
  | <b>PARENT_LEVEL_NAME</b>
  | <b>PARENT_UNIQUE_NAME</b>
}
</pre>


<pre create_analytic_view>
<b>CREATE</b> [ <b>OR REPLACE</b> ] [ { <b>FORCE</b> | <b>NOFORCE</b> } ] [<b>EDITIONABLE</b>]
   <b>ANALYTIC VIEW</b> [ schema. ] /*analytic_view*/identifier 
    [ sharing clause ] 
    [ classification_clause ]...
    analytic_view_using_clause 
    dim_by_clause 
    measures_clause 
    [ create_analytic_view_1 ]...
</pre>

<pre create_analytic_view_1>
      default_measure_clause  
    | default_aggregate_clause 
    | cache_clause 
    | fact_columns_clause 
    | qry_transform_clause 
</pre>

<pre fact_columns_clause>
      <b>FACT COLUMNS</b> "(x,y,z)"
</pre>

<pre sharing_clause>
  <b>SHARING</b> = { <b>METADATA</b> | <b>DATA</b> | <b>NONE</b> }
</pre>

<pre analytic_view_using_clause>
  <b>USING</b> [ schema. ] /*fact_table_or_view*/identifier  [ [ <b>AS</b> ] alias ]
</pre>

<pre dim_by_clause>
  <b>DIMENSION BY</b> ( dim_key [, dim_key ]... )
</pre>

<pre dim_key>
dim_ref 
  [classification_clause]...
  <b>KEY</b>  
    {[alias.] /*fact_column*/identifier   
     |
     (  [alias.] /*fact_column*/identifier [, [alias.] /*fact_column*/identifier]... )
    }
  <b>REFERENCES</b> 
     {   attribute   
      | 
      ( attribute [, attribute]... )
     }   
  <b>HIERARCHIES</b> ( hier_ref [, hier_ref]... )
</pre>

<pre dim_ref>
  [ schema. ] /*attr_dim_name*/identifier [ [<b>AS</b>] dim__alias ]
</pre>

<pre hier_ref>
  [ schema. ] /*hier_name*/identifier [ [ <b>AS</b> ] /*hier_*/alias ] [ <b>DEFAULT</b> ]
  | *
</pre>

<pre measures_clause>
  <b>MEASURES</b>  ( av_measure [, av_measure]... )
</pre>

<pre av_measure>
  meas_name  [{ base_measure_clause | calc_measure_clause }]
    [ classification_clause ]...
</pre>

<pre base_measure_clause>
  [ <b>FACT</b> ] expr [ meas_aggregate_clause ]
</pre>

<pre calc_measure_clause>
  <b>AS</b> ( calc_meas_expression )
</pre>

<pre meas_aggregate_clause>
  <b>AGGREGATE BY</b> /*aggr_function*//*analytic_function*/"aggr_name"
</pre>

<pre default_measure_clause>
  <b>DEFAULT MEASURE</b> /*measure*/identifier
</pre>

<pre default_aggregate_clause>
  <b>DEFAULT AGGREGATE BY</b> /*aggr_function*//*analytic_function*/"aggr_name"
</pre>

<pre cache_clause>
  <b>CACHE</b> cache_specification [, cache_specification]...
</pre>

<pre cache_specification>
<b>MEASURE GROUP</b>
 {    <b>ALL</b> 
   | ( /*measure_name*/identifier [, /*measure_name*/identifier ]... ) [ levels_clause  ]...
 }
</pre>

<pre levels_clause>
  <b>LEVELS</b> ( level_specification [, level_specification ]... )
 [<b>MATERIALIZED</b>]
 [<b>USING</b> identifier]
</pre>

<pre level_specification>
  --( 
  [ [ /*dim_name*/identifier. ] /*hier_name*/identifier. ] /*level_name*/identifier 
  --) 
</pre>


<pre calc_meas_expression>
{    av_meas_expression
   | av_simple_expression
   | single_row_function_expression
   | case_expression
   | compound_expression
   | datetime_expression
   | interval_expression
   | expr    --<--
   | av_hier_expression    -- originally in av_expression (which is orphan in the doc) together with av_meas_expression   
}
</pre>

<pre av_meas_expression>
{  lead_lag_expression
 | av_window_expression 
 | rank_expression 
 | share_of_expression
 | qdr_expression 
}
</pre>

<pre lead_lag_expression>
  lead_lag_function_name ( calc_meas_expression ) <b>OVER</b> ( lead_lag_clause )
</pre>


<pre lead_lag_function_name>
  { <b>LAG</b> | <b>LAG_DIFF</b> | <b>LAG_DIFF_PERCENT</b> | <b>LEAD</b> | <b>LEAD_DIFF</b> | <b>LEAD_DIFF_PERCENT</b> }
</pre>

<pre lead_lag_clause>
<b>HIERARCHY</b> hierarchy_ref <b>OFFSET</b> /*offset_*/expr
  [ { 
      <b>WITHIN</b> { <b>LEVEL</b> | <b>PARENT</b> }
    | <b>ACROSS ANCESTOR AT LEVEL</b> /*level_ref*/identifier [ <b>POSITION FROM</b> { <b>BEGINNING</b> | <b>END</b> } ]
    }  
  ]   
</pre>

<pre hierarchy_ref>
  [ /*attr_dim_*/alias. ] /*hier_*/alias
</pre>

<pre av_window_expression>
	aggregate_function <b>OVER</b> ( av_window_clause )
</pre>

<pre av_window_clause>
<b>HIERARCHY</b> hierarchy_ref
  <b>BETWEEN</b> { preceding_boundary | following_boundary }
[ <b>WITHIN</b> {   <b>LEVEL</b> 
           | <b>PARENT</b>
           | <b>ANCESTOR AT LEVEL</b> level_name 
         }
]
</pre>

<pre preceding_boundary>
{ <b>UNBOUNDED</b> <b>PRECEDING</b> | offset_expr <b>PRECEDING</b> }
<b>AND</b>
{ <b>CURRENT MEMBER</b> 
  | offset_expr  { <b>PRECEDING</b> | <b>FOLLOWING</b> }
  | <b>UNBOUNDED FOLLOWING</b>
}
</pre>

<pre following_boundary>
{ <b>CURRENT MEMBER</b> | /*offset_*/expr <b>FOLLOWING</b> }
<b>AND</b>
{ /*offset_*/expr <b>FOLLOWING</b> | <b>UNBOUNDED FOLLOWING</b> }
</pre>


<pre calc_meas_order_by_clause>
  calc_meas_expression [ { <b>ASC</b> | <b>DESC</b> } ]  [ <b>NULLS</b> { <b>FIRST</b> | <b>LAST</b> } ]
</pre>


<pre share_of_expression>
  <b>SHARE_OF</b> ( calc_meas_expression  share_clause )
</pre>

<pre share_clause>
<b>HIERARCHY</b> hierarchy_ref
  { <b>PARENT</b> 
  | <b>LEVEL</b> /*level_ref*/identifier
  | <b>MEMBER</b> member_expression
  }
</pre>

<pre level_member_literal>
  /*level_ref*/identifier { pos_member_keys | named_member_keys }
</pre>

<pre pos_member_keys>
  <b>[</b>  member_key_expr [, member_key_expr]...<b>]</b>
</pre>

<pre named_member_keys>
  <b>[</b>  /*attr_name*/identifier = member_key_expr [, /*attr_name*/identifier = member_key_expr ]... <b>]</b>
</pre>

<pre hier_navigation_expression>
{
    hier_ancestor_expression
  | hier_parent_expression
  | hier_lead_lag_expression
}
</pre>

<pre hier_ancestor_expression>
<b>HIER_ANCESTOR</b> ( member_expression AT 
                       {   <b>LEVEL</b> /*level_ref*/identifier
                         | <b>DEPTH</b> depth_expression
                       }
                     )
</pre>

<pre member_expression>
{   level_member_literal
  | hier_navigation_expression
  | <b>CURRENT MEMBER</b>
  | <b>NULL</b>
  | <b>ALL</b>
}
</pre>

<pre hier_parent_expression>
  <b>HIER_PARENT</b> ( member_expression )
</pre>

<pre hier_lead_lag_expression>
{ <b>HIER_LEAD</b> | <b>HIER_LAG</b> } ( hier_lead_lag_clause )
</pre>


<pre hier_lead_lag_clause>
member_expression  <b>OFFSET</b> offset_expr
  [ <b>WITHIN</b> 
    {  { <b>LEVEL</b> | <b>PARENT</b> }
    | <b>ACROSS ANCESTOR AT LEVEL</b> /*level_ref*/identifier [ <b>POSITION FROM</b> { <b>BEGINNING</b> | <b>END</b> } ]
    }
  ]
</pre>

<pre qdr_expression>
  <b>QUALIFY</b> ( calc_meas_expression, qualifier )
</pre>

<pre qualifier>
  hierarchy_ref = member_expression
</pre>

<pre av_simple_expression>
  { string_literal | number_literal | <b>NULL</b> | measure_ref }
</pre>

<pre measure_ref>
  [ <b>MEASURES</b>. ] /*meas_name*/identifier
</pre>

<pre create_pdb_from_seed>   
<b>ADMIN USER</b> admin_user_name <b>IDENTIFIED BY</b> password
[
  [ pdb_dba_roles ]
  [ parallel_pdb_creation_clause ]
  [ default_tablespace ]
  [ file_name_convert ]
  [ pdb_storage_clause ]
  [ service_name_convert ]
  [ path_prefix_clause ]
][   -- 16384 rules without this split 
  [ tempfile_reuse_clause ]
  [ user_tablespaces_clause ]
  [ standbys_clause ]
  [ logging_clause ]
  [ create_file_dest_clause ]
  [ <b>HOST</b> = string_literal ]
  [ <b>PORT</b> = number ]
]
</pre>

<pre create_pdb_from_xml>
[ <b>AS CLONE</b> ] <b>USING</b> filename
[
  [ source_file_name_convert | source_file_directory ]
  [ { [ <b>COPY</b> | <b>MOVE</b> ] file_name_convert } | <b>NOCOPY</b> ]
  [ service_name_convert ]
  [ default_tablespace ]
  [ pdb_storage_clause ]
  [ path_prefix_clause ]
][  -- 16384 rules without this split 
  [ tempfile_reuse_clause ]
  [ user_tablespaces_clause ]
  [ standbys_clause ]
  [ logging_clause ]
  [ create_file_dest_clause ]
  [ <b>HOST</b> = string_literal ]
  [ <b>PORT</b> = number ]
]
</pre>

<pre create_pdb_clone>
{ { <b>FROM</b> { src_pdb_name [ @ dblink ] } | { <b>NON$CDB</b> @ dblink } }
|
  { <b>AS PROXY FROM</b> src_pdb_name @ dblink }
}
[
  [ parallel_pdb_creation_clause ]
  [ default_tablespaces ]
  [ pdb_storage_clause ]
  [ file_name_convert ]
  [ service_name_convert ]
  [ path_prefix_clause ]
  [ tempfile_reuse_clause ]
  [ <b>SNAPSHOT COPY</b> ]
  [ user_tablespaces_clause ]
][   
  [ standbys_clause ]
  [ logging_clause ]
  [ create_file_dest_clause ]
  [ keystore_clause ]
  [ pdb_refresh_mode_clause ]
  [ <b>RELOCATE</b> ]
  [ <b>NO DATA</b> ]
  [ <b>HOST</b> = string_literal ]
  [ <b>PORT</b> = number ]
]
</pre>

<pre modify_table_default_attrs>
<b>MODIFY DEFAULT ATTRIBUTES</b>
[
   [ <b>FOR</b> partition_extended_name ]
   [ deferred_segment_creation ]
   [ read_only_clause ]
   [ indexing_clause ]
   [ segment_attributes_clause ]
   [ table_compression ]
][   
   [ inmemory_clause ]
   [ <b>PCTTHRESHOLD</b> integer ]
   [ prefix_compression ]
   [ alter_overflow_clause ]
   [ { <b>LOB</b> (LOB_item) | <b>VARRAY</b> varray } (LOB_parameters) ]...
]   
</pre>

<pre unified_noaudit>
<b>NOAUDIT</b>
  {{ <b>POLICY</b> policy [ { <b>BY</b> user [, user]... } | by_users_with_roles ] }
  |
  { <b>CONTEXT NAMESPACE</b> namespace <b>ATTRIBUTES</b> attribute [, attribute ]...
      [, <b>CONTEXT NAMESPACE</b> namespace <b>ATTRIBUTES</b> attribute [, attribute ]... ]...
    [ <b>BY</b> user [, user]... ]
  }} ;
</pre>

<pre create_tablespace_set>
<b>CREATE TABLESPACE SET [IF NOT EXISTS]</b> tablespace_set
  [ <b>IN SHARDSPACE</b> shardspace ]
  [ <b>USING TEMPLATE </b>
    ( /*{<<<wrong*/[ <b>DATAFILE</b> file_specification/*<<<missing*/ [, file_specification ]... ] permanent_tablespace_attrs )
  ] 
</pre>


<pre XML_table_column>
column
  { <b>FOR ORDINALITY</b> 
  | [/*<--was: { */ datatype | <b>XMLTYPE</b> [ (<b>SEQUENCE</b>) <b>BY REF</b> ] ] 
