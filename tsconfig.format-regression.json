{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist/format-regression",
    "strict": false,
    "noCheck": true,
    "noImplicitOverride": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/test/typescript/oracle/dbtools/app/FormatRegressionTest.ts"]
}
