create or replace procedure cdb_switch_container sharing=metadata (pdb_name varchar2) is
begin
  null;
end;

CREATE TYPE customer_typ
 OID '82A4AF6A4CD9656DE034080020E0EE3D';

create procedure pc023 is
  e number;
begin
  rollback release;
end;

begin
   pc  := chr(70 using p1%charset);
   select chr(65 using char_cs) into vc from dual;
   select translate(nvc using char_cs) into vc from dual;
   vc  := chr(ascii('G') using nchar_cs);
   select translate(nvc using p1%charset);
   insert into nch180_tab3 values
  (
    chr((ascii(:new.char_)+ascii(N'A')) using NCHAR_CS)
  ); 
      for r in 1 .. rowset(c).tab_varchar2.count() loop
        rowset(c).tab_varchar2(r) := case case_function
                                       when 'UPPER'
                                       then upper(rowset(c).tab_varchar2(r))
                                       else rowset(c).tab_varchar2(r)
                                     end;
      end loop;
        
end;

create or replace function ECHO5(tab table) return table
pipelined row  using ECHO_PACKAGE;

create or replace function ECHO9(tab table) return table
pipelined  polymorphic using ECHO_PACKAGE;

