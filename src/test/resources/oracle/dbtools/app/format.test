`create flexible domain export_test.expense_details ( val1,
                                                     val2,
                                                     val4 ) 
                                                     choose domain 
                                                     using ( typ varchar2(10) ) 
                                                     from case when typ = 'Meals' then
export_test.meals_details(val1, val2, val4) when typ like 'Lodg%' then
export_test.lodging_details(val1, val4) end;

CREATE FLEXIBLE DOMAIN expense_details (val1, val2, val3, val4)
    CHOOSE DOMAIN USING (typ VARCHAR2(10))
    FROM DECODE(typ,
              'Flight', flight_details(val1, val2, val3),
              'Meals', meals_details(val1, val2, val4),
              'Lodging', lodging_details(val1, val4));
`
->`CREATE FLEXIBLE DOMAIN export_test.expense_details ( val1,
                                                     val2,
                                                     val4 )
    CHOOSE DOMAIN USING ( typ VARCHAR2(10) )
FROM CASE
    WHEN typ = 'Meals' THEN
    export_test.meals_details(val1, val2, val4)
    WHEN typ LIKE 'Lodg%' THEN
    export_test.lodging_details(val1, val4)
END;

CREATE FLEXIBLE DOMAIN expense_details ( val1,
                                         val2,
                                         val3,
                                         val4 )
    CHOOSE DOMAIN USING ( typ VARCHAR2(10) )
FROM DECODE ( typ,
              'Flight', flight_details ( val1, val2, val3 ),
              'Meals', meals_details ( val1, val2, val4 ),
              'Lodging', lodging_details ( val1, val4 ) );`
;  
 
