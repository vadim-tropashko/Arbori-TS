`begin
        if REGEXP_LIKE(v_version, '^[[:digit:]]+$') or v_version 
    like '%,%' or v_version like '%any%' or v_version like '%all%' or 
 v_version like '%,%' then
            v_valid := 'N';
        end if;
        select 1 from a where 1=2 or 2=3;
end;
/`
->
`BEGIN
    IF regexp_like(v_version, '^[[:digit:]]+$')
    OR v_version LIKE '%,%'
    OR v_version LIKE '%any%'
    OR v_version LIKE '%all%'
    OR v_version LIKE '%,%' THEN
        v_valid := 'N';
    END IF;

    SELECT
        1
    FROM
        a
    WHERE
        1 = 2
        OR 2 = 3;

END;
/`
;  
 
