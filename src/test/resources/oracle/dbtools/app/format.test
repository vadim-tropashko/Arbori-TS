++56;
`select
    json{'_id' : ce_latest.clinical_event_id,
         'eventId' : ce_latest.event_id,
         'eventCd' : ce_latest.event_cd,
         'encounter' :[select
                                   json{'organization' :[select
                                                                                  json{'orgName' : org.org_name,
                                                                                       'orgId' : org.organization_id}
                                                                                 from organization org
                                                          where org.organization_id = encntr.organization_id
                                   ]}
                                  from encounter encntr
                   where encntr.encntr_id = ce_latest.encntr_id
    ],
         'caseReport' :[select
                                     json{'catalogCd' : cr.catalog_cd}
                                    from case_report cr
                    where cr.event_id = ce_latest.event_id
    ]}
   from dual;`
->
`SELECT
    JSON {
        '_id' : ce_latest.clinical_event_id,
         'eventId' : ce_latest.event_id,
         'eventCd' : ce_latest.event_cd,
         'encounter' : [
            SELECT
                JSON {
                    'organization' : [
                        SELECT
                            JSON {
                                'orgName' : org.org_name,
                                'orgId' : org.organization_id
                            }
                        FROM
                            organization org
                        WHERE
                            org.organization_id = encntr.organization_id
                    ]
                }
            FROM
                encounter encntr
            WHERE
                encntr.encntr_id = ce_latest.encntr_id
        ],
         'caseReport' : [
            SELECT
                JSON {
                    'catalogCd' : cr.catalog_cd
                }
            FROM
                case_report cr
            WHERE
                cr.event_id = ce_latest.event_id
        ]
    }
FROM
    dual;`
;

