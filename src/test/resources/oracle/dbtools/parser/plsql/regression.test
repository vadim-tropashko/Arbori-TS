read only;

alter table txfzm1 split partition p3 at (250,15) into
( partition p3a, partition p3b) online allow clustering;

alter table txf2 move subpartition p2_sp2 tablespace sysaux
read only nologging including rows where
c1 < 800 and c4>900;

create table t2 partition by range(c1) (partition p1 values less than (maxvalue)) for exchange with table t1;

alter table tbl enable row change tracking;

create table t21846198 (c1 number, c2 number) partition by list (c1) 
automatic subpartition by list(c2) subpartition template () (partition p1 values (1));

