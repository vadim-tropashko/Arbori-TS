<<create_index>>
CREATE VECTOR INDEX [IF NOT EXISTS] identifier
ON [schema.] identifier ( column [, column]... )
[ INCLUDE  paren_expr_list
| [GLOBAL] ORGANIZATION [INMEMORY | NEIGHBOR | GRAPH | PARTITIONS]...
| [WITH] DISTANCE identifier   --<-- EUCLIDEAN, COSINE, etc
| [WITH] [TARGET] ACCURACY [expr_percent] 
| [PARAMETERS ( accuracy_parameter [, accuracy_parameter]... )]
| PARALLEL digits
| index_attributes
]...
--;
<<>>

<<accuracy_clause>>
[WITH] [TARGET] ACCURACY [expr_percent] 
[PARAMETERS ( accuracy_parameter [, accuracy_parameter]... )]
<<>>

<<accuracy_parameter>>{
  TYPE identifier   --<-- IVF, HNSW 
 |
  {NEIGHBORS|NEIGHBOR|NEIGHBOURS|NEIGHBOUR} [PARTITION|PARTITIONS][identifier] {expr | M expr }
 |
  {EFCONSTRUCTION|EFSEARCH} expr 
 |
  {MIN_VECTORS_PER_PARTITION|SAMPLES_PER_PARTITION} expr  
}<<>>

<<vector_chunks>>
 VECTOR_CHUNKS ( chunks_arguments )
<<>> 
 
<<chunks_arguments>>
 expr [ chunking_spec ]
<<>>

<<chunking_spec>>
    [ BY chunking_mode ]
    [ MAX digits ]
    [ OVERLAP digits ]
    [ SPLIT [ BY ] split_character_list ]
    [ LANGUAGE identifier ]
    [ NORMALIZE normalization_spec ]
    [ EXTENDED ]
<<>>

<<chunking_mode>>
 WORDS
 | CHARS
 | CHARACTERS
 | VOCABULARY column
<<>>
 
/* <chunker name> ::=
 <qualified name>
 
 <chunker partitioning spec> ::=
 <left paren>
 <value expression> [ { <comma> <value expression> } ... ]
 <right paren>
*/ 
 
<<split_character_list>>
   NONE
 | BLANKLINE
 | NEWLINE
 | SPACE
 | RECURSIVELY
 | SENTENCE
 | CUSTOM custom_split_character_list
<<>> 
 
 <<custom_split_character_list>>
 (
 literal [ , literal ] ...
 )
 <<>>
 
 <<normalization_spec>>
   NONE
 | ALL
 | custom_normalization_spec
 <<>>
 
 <<custom_normalization_spec>>
 (
 normalization_mode [ , normalization_mode ] ... 
 )
 <<>>
 
 <<normalization_mode>>
 WHITESPACE
 | PUNCTUATION
 | WIDECHAR
 <<>>

<<json_oper>>
    add_set_op
  | append_op 
  | assign_op
  | case_op 
  | copy_op
  | insert_op
  | intersect_op
  | keep_op
  | merge_op
  | minus_op  
  | nested_path_op
  | prepend_op
  | remove_op
  | remove_set_op
  | rename_op
  | replace_op   
  | set_op  
  | sort_op
  | union_op
 <<>>
 
 <<sort_op>>
 SORT path_expr 
   {    REVERSE 
     | [ REMOVE NULLS ] ORDER BY { path_expr [ ASC | DESC ] }
             [ , { path_expr [ ASC | DESC ] } ]... 
     | [ ASC | DESC ] [ UNIQUE ] [ REMOVE NULLS ]       
    }  
  [ {  IGNORE | ERROR | NULL } ON MISSING ]
  [ {  IGNORE | ERROR | NULL } ON MISMATCH ]
  [ {  IGNORE | ERROR } ON EMPTY ]
  [ {  IGNORE | ERROR } ON ERROR ]
<<>>

<<case_op>>
   CASE 
      { WHEN string_literal THEN ( json_oper [, json_oper]... ) }...
      ELSE ( json_oper [, json_oper]... )
   END
<<>>   
  
<<intersect_op>>
INTERSECT pathExpr = rhsExpr 
    [ { IGNORE | ERROR | CREATE | NULL } ON MISSING 
    | { IGNORE | ERROR | CREATE | NULL } ON MISMATCH
    | { IGNORE | ERROR | NULL } ON NULL 
    ]... 
<<>>    

<<union_op>>
UNION pathExpr = rhsExpr 
    [ { IGNORE | ERROR | CREATE | NULL } ON MISSING 
    | { IGNORE | ERROR | CREATE | NULL } ON MISMATCH
    | { IGNORE | ERROR | NULL } ON NULL 
    ]... 
<<>> 

<<minus_op>>
MINUS pathExpr = rhsExpr 
    [ { IGNORE | ERROR | CREATE | NULL } ON MISSING 
    | { IGNORE | ERROR | CREATE | NULL } ON MISMATCH
    | { IGNORE | ERROR | NULL } ON NULL 
    ]... 
<<>> 

<<nested_path_op>>
NESTED [PATH] path_expr ( [ [ operation ] [ , operation ]...] )  
<<>>

