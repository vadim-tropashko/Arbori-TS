   identifier
 | identifier.identifier  
 | identifier.identifier.identifier  
}  
[ @ dblink ]  
[ "(x,y,z)" ]
</PRE>*/

<PRE "(x,y,z)">
( [ [ <B>DISTINCT</B> | <B>ALL</B> ] "expr_list" ] )
</PRE>


<<virtual_column_definition>>
column [   datatype [ DOMAIN [ domain_owner.] domain_name ]
         | DOMAIN [ domain_owner.] domain_name [ COLLATE column_collation_name ] 
       ]
  [ VIRTUAL
  | VISIBLE 
  | INVISIBLE
  | GENERATED ALWAYS 
  ] ...
  AS (column_expression) 
  [ VIRTUAL
  | VISIBLE 
  | INVISIBLE
  | MATERIALIZED
  | GENERATED ALWAYS 
  | evaluation_edition_clause
  | unusable_editions_clause
  | inline_constraint
  ] ...
<<>>  

<pre column_collation_name>
   identifier
   | identifier <b>DEFAULT</b> expr 
</pre>



<<identity_clause>>
GENERATED [ ALWAYS | BY DEFAULT [ ON NULL [ FOR INSERT { ONLY | AND UPDATE } ]]] 
AS {
 IDENTITY [ ( identity_options ) | identity_options ]
 |
 expr
}
<<>>

<PRE identity_options>
{ <b>RESTART</b>
| <b>START</b> <b>WITH</b> { integer | <b>LIMIT VALUE</b> } -- was: (...)
| <b>INCREMENT</b> <b>BY</b> integer
| { <b>MAXVALUE</b> integer | <b>NOMAXVALUE</b> }
| { <b>MINVALUE</b> integer | <b>NOMINVALUE</b> }
| { <b>CYCLE</b> | <b>NOCYCLE</b> }
| { <b>CACHE</b> integer | <b>NOCACHE</b> }
| { <b>ORDER</b> | <b>NOORDER</b> }
| { <b>CYCLE</b> | <b>NOCYCLE</b> }
| { <b>KEEP</b> | <b>NOKEEP</b> }
| { <b>SCALE</b> | <b>NOSCALE</b> }
| <b>EXTEND</b>
}...
</PRE>


<pre add_column_clause> 
   <b>ADD</b> {
   {(relational_properties)   -- refactored
                        -- was missing brackets: ({column_definition | virtual_column_definition}   -- missing ( missing }
                        --  [, {column_definition | virtual_column_definition} ] ...)  -- missing {}
    | column_definition   -- ALTER TABLE emp ADD Update_id2 NUMBER;
    | virtual_column_definition
    }
    [ column_properties ]
    [ out_of_line_part_storage [, out_of_line_part_storage]...
     | (out_of_line_part_storage [, out_of_line_part_storage]...)
    ]
   }
</pre>

<pre add_period_clause> 
   <b>ADD</b> 
   { (period_definition)   
   |  period_definition     --missing
   }
</pre>


<PRE LOB_storage_clause>
<B>LOB</B>
 (column [, column ]...)
     [<B>STORE AS</b> 
           { identifier 
              | { <B>{SECUREFILE | BASICFILE}</b>  [identifier]
                  | (LOB_storage_parameters [<B>INDEX</B> identifier] ) 
                  | LOB_storage_parameters
                }...
           }
      ][ <B>QUERY AS VALUE</b> ]     
</PRE>

<PRE allocate_extent_clause>
<B>ALLOCATE EXTENT</B>
  [ ( { <B>SIZE</B> size_clause
      | <B>DATAFILE</B> string_literal        --> was: 'filename'
      | <B>INSTANCE</B> integer
      | <B>FREELIST GROUP</B> integer
      } ...
    )
  ]
</PRE>

<pre LOB_storage_parameters>       --> simplified
 { <b>TABLESPACE</b> tablespace
  | storage_clause 
  | LOB_parameters [storage_clause]
  }...
</pre>

<PRE select_list>
{ 
    *
 |  select_term 
 | select_list , *
 | select_list , select_term
}
</PRE>
<PRE select_term>{ 
   [ schema. ] { table } .*   --> was: | table|view|materialized view  
  | expr 
  | condition
  | "aliased_expr"
  | "aliased_condition"
}</PRE>

<PRE as_alias>  -- not inlined in order to keep auxiliary node; reusing it in other places 
  [ <B>AS</B> ] c_alias 
</PRE>

<PRE "aliased_expr">
  expr as_alias 
</PRE>
<PRE "aliased_condition">
  condition as_alias 
</PRE>


<PRE model_condition>{   --> rule entirely missing 
  is_any_condition | 
  is_present_condition 
}</PRE>

<pre is_present_condition>
cell_assignment <b>IS PRESENT</b>
</pre>

<PRE multiset_condition>{   --> rule entirely missing 
  is_a_set_condition | 
  is_empty_condition |
  member_condition |
  submultiset_condition 
}</PRE>

<PRE pattern_matching_condition>{   --> rule entirely missing 
  like_condition 
}</PRE>

<PRE comparison_condition>{   --> rule entirely missing 
  simple_comparison_condition |
  group_comparison_condition |
  between_condition |
  <B>CURRENT OF</B> identifier |  -- plsql static.htm#CHDGEHBF
  <B>CURRENT OF</B> identifier . identifier |  
  column <B>IS [NOT] DANGLING</B> | -- sql 
  column <B>IS LABELED</B> expr    |  
  lnnvl
}</PRE>

--> logical_condition=compound_condition?  

<pre compound_condition>{   
  ( condition )
| <b>NOT</b> condition
| condition AND_OR condition
}</pre>
   
<pre AND_OR>{ 
   <b>AND</b> | <b>OR</b>
}</pre>


<pre SET_OPER> 
{ <b>UNION</b> [<b>ALL</b>] | <b>INTERSECT</b> [<b>ALL</b>] | <b>MINUS</b> [<b>ALL</b>] | <b>EXCEPT</b> [<b>ALL</b>] }
</pre>


<pre function_expression> {   --> rule entirely missing 
    function        -- includes aggregate_function 
  | function_call   -- pl/sql definition which allows arrow argument assignments
  | function_expression . function_call   -- a().b()
  | function_expression . identifier   -- (TREAT(author AS employee_t).salary
}</pre>

<PRE count>
<B>COUNT</B>( [ <B>DISTINCT</B> | <B>UNIQUE</B> | <B>ALL</B> ] { * | expr | identifier . * } )   -- doc bug: COUNT(ALL *)
</PRE>

<PRE approx_count>
  <B>APPROX_COUNT</B>( count_arg )   
| <B>APPROX_COUNT_DISTINCT</B>( count_arg )   
</PRE>

<PRE count_arg>
  [ <B>DISTINCT</B> | <B>UNIQUE</B> | <B>ALL</B> ] { * | expr | identifier . * }
</pre>

<PRE count_analytic>
      count over_clause   
    | count keep_clause 
    | count keep_clause over_clause
</PRE>


<PRE over_clause>
  <B>OVER</B> (analytic_clause)
</PRE>


<pre alter_external_table_clauses>{   --> name mismatch 
  alter_external_table    
}</pre>

<pre spreadsheet_column_clauses>{   --> name mismatch 
  model_column_clauses    
}</pre>


<pre number>  
numeric_literal --> from pl/sql grammar 
/*obsolete: --> rewritten in terms of digits
[ + | - ]
{ digits [ . ] [ digits ]
| . digits
}
[ <B>E</B> [ + | - ] digits ]
[ <B>F</B> | <B>D</B> ]*/
</pre>

<pre scalar_subquery_expression>{   --> rule missing 
  ( subquery )    
}</pre>

<pre par_subquery>{   -->  not necessarily one column 
  ( subquery ) 
 | 
  ( <b>VALUES</b> (expr [, expr ]...) [expr [, expr]...] )    
 | 
   values_clause 
}</pre>


<pre integer>
{digits | +digits | -digits}
</pre>

