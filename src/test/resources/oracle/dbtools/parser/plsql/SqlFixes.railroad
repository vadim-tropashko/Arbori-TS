  }...
]</PRE>

<pre enable_disable_clause>
[ --<-- e.g. ALTER TABLE T2.PK_SUPPORT_INDEX DROP CONSTRAINT PK_TT1 CASCADE DROP INDEX;
  { <b>ENABLE</b> | <b>DISABLE</b> }
  [ <b>VALIDATE</b> | <b>NOVALIDATE</b> ]
  { <b>UNIQUE</b> (column [, column ]...)
  | <b>PRIMARY KEY</b>
  | <b>CONSTRAINT</b> constraint_name
  | <b>EXTERNAL_DATA_CACHE</b>
  }
  [ using_index_clause ]
  [ exceptions_clause ]
  [ <b>CASCADE</b> ]
]
[ { <b>KEEP</b> | <b>DROP</b> } {<b>INDEX | DOMAIN</b>} ]
</pre>


<PRE merge_table_partitions>
<B>MERGE PARTITIONS</B> 
   [ identifier  [<b>TO</b> identifier | [ , identifier ]... ] 
   | <b>FOR</b> "(x,y,z)" [,<b>FOR</b> "(x,y,z)"]... ] 
   [ <B>INTO</B> partition_spec ] 
   [ (subpartition_spec [, subpartition_spec]...)
   | filter_condition 
   | dependent_tables_clause 
   | update_index_clauses 
   | parallel_clause 
   | <b>ONLINE</b> 
   | allow_disallow_clustering 
   | <b>STORE IN</b> ( tablespace [, tablespace]...) ]...
</PRE>
    
<PRE index_partition_description>
