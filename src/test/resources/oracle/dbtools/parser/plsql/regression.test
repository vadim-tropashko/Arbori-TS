create table hypt4(n1 number, n2 number)
external partition attributes (type oracle_loader
                               default directory def_dir1
                               access parameters(fields terminated by ',')
                               reject limit unlimited)
partition by range(n2)
(
  partition ip1 values less than(50) indexing off,
  partition exp1 values less than(100) external
        location('datafile1.dat') indexing off,
  partition exp2 values less than(124) external
        location('datafile2.dat') indexing on,
  partition ip2 values less than(150)
);

create table hypt4
(
        n1 int,
        n2 int,
        v1 as (n1+n2) virtual,
        v2 as (n1*n2) visible,
        v3 generated always as (n2-n1)
)
external partition attributes (default directory def_dir1
                               access parameters(fields terminated by ',')
                               reject limit unlimited)
partition by range(v1) interval(100)
(
  partition ip1 values less than(75),
  partition ip2 values less than(150),
  partition exp1 values less than(200) external location('datafile1.dat'),
  partition exp2 values less than(300) external location('datafile2.dat')
);

alter hierarchy if exists product_hier1 compile;
