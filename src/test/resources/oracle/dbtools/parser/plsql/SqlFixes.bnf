/*
  The rules from this file are NOT processed recursively.
  For example, json_table refers to JSON_table_on_empty_clause
  which is defined in the documentation. 
  This symbols has to be added to the todo list manually
*/  


-- query_block == max subquery  
-- for backward compatibility
-- ensured programmatically by overriding Earley.tree()
query_block::=
     dummyRule
   | notToReduce  
;   
  
/*sim_expr::=
     dummyRule
   | notToReduce  
;*/    



/***** Json fixes ****/


JSON_object_access_expr ::=
    /*table_alias "." JSON_column ( "." JSON_object_key (array_step | "(" ")")* )+ 
    format_clause?                                         -- e.g.  m.json.actors[0] FORMAT JSON,
    |
    table_alias "." JSON_column ( ("." JSON_object_key)? (array_step | "(" ")")+ )+ 
    format_clause? */                                        -- e.g.  jtab.jcol[*].maxNumber()
    
    table_alias "." JSON_column ( "." JSON_object_key | array_step  )+ 
    -- too ambiguous: ("AS" datatype)?
;    
    
array_step ::=
    "[" ( -- missing "("
         integer ( "TO" integer )? ( "," integer ( "TO" integer )? )* 
         | "*" 
         )
    "]"
|   "(" ")"    
;    

json_table ::=
    ("JSON_TABLE"|'JSON_EXPAND_ARRAY') "(" "NESTED"? expr format_clause? ("," JSON_basic_path_expression)?
		 (JSON_table_on_error_clause)? (JSON_table_on_empty_clause)? ('NULL' 'ON' 'MISMATCH')?
		  JSON_columns_clause 
		  ")"
;		 
		

JSON_value_column ::=    /* unified with JSON_query_column */
  column_name JSON_value_return_type? format_clause? 
  JSON_query_wrapper_clause? 
  JSON_query_returning_clause?  -- JSON_TABLE(t.json COLUMNS(actors FORMAT JSON PRETTY ASCII))
  ("ORDERED"? "PATH" JSON_path)? json_value_on__*
; 

 
  
  
JSON_exists_column ::=
  column_name JSON_value_return_type?
  "EXISTS"  ("PATH" JSON_path)? JSON_exists_on_error_clause? 
  allow_boolean_number_conversion?     
;  
  
JSON_nested_path ::=
  "NESTED" "PATH"? JSON_path JSON_columns_clause
;  

JSON_path ::=
   JSON_basic_path_expression | JSON_relative_object_access
;   

JSON_relative_object_access ::=
   JSON_object_key array_step? ("." JSON_object_key array_step?)*
;


nested_clause_1 ::=

  --table_reference
   ("NESTED" "PATH"?) 
      (
         JSON_relative_object_access |
         identifier ("," JSON_basic_path_expression)
      )?
      JSON_table_on_error_clause?
      --"COLUMNS" "(" JSON_column_definition+ ")"
      JSON_columns_clause
;

nested_clause ::=
      nested_clause_1
    | nested_clause_1 identifier
    | nested_clause nested_clause 
;



/* now in the 21c doc
JSON_ARRAY ::=
  "JSON_ARRAY" "(" JSON_ARRAY_content ")" | "JSON" "[" JSON_ARRAY_content "]"
;
*/

JSON_ARRAY_content ::=
  (JSON_ARRAY_element ( "," JSON_ARRAY_element )* )?
  (JSON_on_null_clause)* JSON_returning_clause? "STRICT"? format_clause?
; 
 
JSON_ARRAY_element ::=
   expr format_clause?
  |  JSON_ARRAY
  |  json_object
;   


json_object ::= 
    ("JSON_OBJECT"|"JSON")? "{" JSON_OBJECT_content "}"   
  | ("JSON_OBJECT"|"JSON")? "[" JSON_OBJECT_content "]"     
  | ("JSON_OBJECT"|"JSON")? "[" "{" JSON_OBJECT_content "}" "]"     
  | ("JSON_OBJECT"|"JSON"|"BSON"|"OSON") "(" JSON_OBJECT_content ")"    
  -- derived from possibility of content being empty:
  --| "JSON_OBJECT" "{"  "}"      | "JSON" "{"  "}"           -- empty constructor examples
  --| "JSON_OBJECT" "["  "]"      | "JSON" "["  "]"            
; 

JSON_OBJECT_content ::= 
 (
     "*" | 
     entry ( "," entry )*
  )?                                              
  (
   JSON_on_null_clause | JSON_returning_clause |    
   ("STRICT"|"EXTENDED") |
   (("WITH"|"WITHOUT") ("UNIQUE" "KEYS"?|"TYPENAME") ) |
   JSON_on_error_clause |
   type_strict_lax |
   inline_constraint
  )*
;


entry ::= (
  regular_entry 
   column_tags_clause?   -- added to parse example#2 https://docs-stage.oracle.com/en/database/oracle/oracle-database/23/sqlrf/create-json-relational-duality-view.html
   format_clause? 
   JSON_on_null_clause? 
  | wildcard
  | json_name_value_pair 
  | json_name_value_pair format_clause? JSON_returning_clause 
  | 'UNNEST' '(' duality_subquery ')'
  | duality_subquery
  | key_value_clause
) 'HIDDEN'?    
;

json_name_value_pair: pls_expr 'IS' pls_expr
              | string_literal 'IS' expr
;

regular_entry ::=
  "KEY"? expr "VALUE" expr |
   expr (":" (expr))? |
   --expr ":" "{" JSON_OBJECT_content "}" |   --will amend json_object
   column 
;    
wildcard ::=  (id ".")? id "." "*"
;

-- doesn't fit "delete" and "update" returning_clause; 
JSON_returning_clause::= "RETURNING" datatype ('ETAG'|'REFERENCE'|'VALUE')? 'INCLUDE'? format_clause?
;

format_clause ::=  "FORMAT" "JSON" | "FORMAT" "OSON" | "FORMAT" "BSON"
                 | "FORMAT" "DENSE" | "FORMAT" "SPARSE"
;


JSON_on_null_clause::= ("SQL"? "NULL" | "ABSENT" ) "ON" ("NULL" | "EMPTY")
;


json_transform ::= 'JSON_TRANSFORM' '(' json_transform_col (',' json_transform_col)* ')'
; 

json_transform_col ::=
    input_expr 
    ( format_clause
    | ',' json_oper
    | JSON_TRANSFORM_returning_clause  
    | JSON_passing_clause
    | format_clause
    | 'NO_PARTIAL_OSON_UPDATE'
    | type_strict_lax
    )*
    ('AS' identifier)?
;

JSON_TRANSFORM_returning_clause: 
'RETURNING' ( 
     'VARCHAR2' ( '(' size ('BYTE' | 'CHAR')? ')' )?
     | 'CLOB'
     | 'BLOB'
     | 'JSON'
    )
   ('ALLOW' | 'DISALLOW' | 'PRETTY')?
;

transform_directive ::= (('CREATE' 'OBJECT'? | 'REPLACE' | 'IGNORE' | 'ERROR') 'ON' ('EXISTING'|'MISSING'|'NULL'))
;

keep_op ::= 'KEEP' (pathExpr (('IGNORE' | 'ERROR') 'ON' 'MISSING')? )
(',' pathExpr (('IGNORE' | 'ERROR') 'ON' 'MISSING')? )*
;
rename_op ::= 'RENAME' pathExpr ('WITH'|'=') string_literal (('IGNORE' |
'ERROR') 'ON' 'MISSING')?
;
assign_op ::= 'ASSIGN' pathExp '=' rhsExpr (('IGNORE' | 'ERROR' | 'REPLACE')
'ON' 'EXISTING')?(('CREATE' |'IGNORE' | 'ERROR') 'ON' 'MISSING')?
(('NULL' | 'IGNORE' | 'ERROR') 'ON' 'NULL')?
;

/*json_oper ::= --(removeOp | insertOp | replaceOp | appendOp | setOp | renameOp | keepOp | assignOp | unionOp | sortOp | mergeOp )
    add_set_op
  | append_op 
  | case_op
  | copy_op
  | insert_op
  | intersect_op
  | keep_op
  | merge_op
  | minus_op  
  | nested_path_op
  | prepend_op
  | remove_op
  | remove_set_op
  | rename_op
  | replace_op   
  | set_op  
  | sort_op
  | union_op
 ;

insertOp ::= 'INSERT' pathExp '=' rhsExpr transform_directive? 
                                          (('NULL' | 'IGNORE' | 'ERROR' | 'REMOVE') 'ON' ('EXISTING'|'MISSING'|'NULL'))?
;
removeOp ::= 'REMOVE' pathExp (('IGNORE' | 'ERROR') 'ON' 'MISSING')?
;

replaceOp ::= 'REPLACE' pathExp '=' rhsExpr (('CREATE' | 'IGNORE' |
'ERROR') 'ON' 'MISSING')? (('NULL' | 'IGNORE' | 'ERROR' | 'REMOVE')
'ON' 'NULL')?
;
appendOp ::= 'APPEND' pathExp '=' rhsExpr (('CREATE' | 'IGNORE' |
'ERROR') 'ON' 'MISSING')? (('NULL' | 'IGNORE' | 'ERROR') 'ON' 'NULL')?
;
setOp ::= ('SET'|'LET') pathExp '=' rhsExpr transform_directive? (('CREATE' |'IGNORE' | 'ERROR') 'ON' 'MISSING')?
(('NULL' | 'IGNORE' | 'ERROR') 'ON' 'NULL')?
;
renameOp ::= 'RENAME' pathExpr ('WITH'|'=') string_literal (('IGNORE' |
'ERROR') 'ON' 'MISSING')?
;
keepOp ::= 'KEEP' (pathExpr (('IGNORE' | 'ERROR') 'ON' 'MISSING')? )
(',' pathExpr (('IGNORE' | 'ERROR') 'ON' 'MISSING')? )*
;
assignOp ::= 'ASSIGN' pathExp '=' rhsExpr (('IGNORE' | 'ERROR' | 'REPLACE')
'ON' 'EXISTING')?(('CREATE' |'IGNORE' | 'ERROR') 'ON' 'MISSING')?
(('NULL' | 'IGNORE' | 'ERROR') 'ON' 'NULL')?
;
unionOp ::= 'UNION' pathExp '=' rhsExpr (('IGNORE' | 'ERROR' | 'REPLACE')
'ON' 'EXISTING')?(('CREATE' |'IGNORE' | 'ERROR') 'ON' 'MISSING')?
(('NULL' | 'IGNORE' | 'ERROR') 'ON' 'NULL')?
;
sortOp ::= 'SORT' expr 
;
mergeOp ::= 'MERGE' pathExp '=' rhsExpr 
;
*/

rhsExpr ::= ('PATH')? expr  ('FORMAT' 'JSON')? 
;

/* doesn't match doc, addendum? Amended table_partition_description by adding JSON_storage_clause in SqlRules.extractRules()
table_partition_description ::= segment_attributes_clause? (table_compression | key_compression)?
('OVERFLOW' segment_attributes_clause?)? ((LOB_storage_clause | varray_col_properties |
JSON_storage_clause)+ )?
;
*/

JSON_storage_clause ::= 'JSON' '(' json_column (',' json_column)* ')' 'STORE' 'AS' ( ( '('
JSON_parameters ')') | (identifier) | ( identifier '(' JSON_parameters ')' ) )
;
JSON_parameters ::= ( ('TABLESPACE' tablespace ) | storage_clause | ('CHUNK' integer) |
('PCTVERSION' integer) | 'RETENTION' | ('FREEPOOLS' integer) 
   | 'COMPRESS' | 'HIGH' | 'CACHE' | 'NOCACHE'
   | 'DISABLE' 'STORAGE' 'IN' 'ROW'
) * 
;

/*json_serialize ::= 'JSON_SERIALIZE' '(' expr JSON_returning_clause? 'PRETTY'? 'ASCII'? 'TRUNCATE'? JSON_on_error_clause? ')'
;*/

JSON_on_error_clause ::= ('NULL' | 'ERROR') 'ON' 'ERROR'
;

json_equal: 'JSON_EQUAL' '(' expr /*JSON_function ('FORMAT' 'JSON')?*/ 
             ',' expr /*JSON_function ('FORMAT' 'JSON')?*/ ')'
;

-- addendum
JSON_condition: json_equal
;


