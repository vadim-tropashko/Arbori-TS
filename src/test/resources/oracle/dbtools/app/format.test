                                        On T25438.LANGUAGE = 'US' ) 
                                   On T25919.CODE = T59301.INVOICE_TYPE_CODE ) 
                              On T24059.FISCAL_DAY_DATE = T59301.INVOICED_ON_DATE ) 
                          On T7447.ORGANIZATION_ID = T59301.PAYABLES_BU_ID) 
                     On T7439.PARTY_ID = T59301.SUPPLIER_PARTY_ID) On T1343.ADJUSTMENT_PERIOD_FLAG = 'N'  ) 
                On T229.CODE_COMBINATION_ID = T59301.GL_CODE_COMBINATION_ID) On T301.LEDGER_ID = T59301.XLA_LEDGER_ID) 
           On T16306.NATURAL_ACCOUNT_SEGMENT = T59301.NATURAL_ACCOUNT_SEGMENT;`
