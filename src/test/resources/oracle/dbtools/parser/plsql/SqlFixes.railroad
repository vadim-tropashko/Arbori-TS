<PRE string>  -- there is now a webpage http://st-doc.us.oracle.com/sql_grammar/sqlbnf/bnffiles/string.htm
              -- however, in many doc examples string is something like: 
              -- XMLSCHEMA "http://www.example.com/xwarehouses.xsd"
 {
     --identifier |
     string_literal |
     id_or_qualid
 }
</PRE>


<pre id_or_qualid>
{identifier |  id_or_qualid.identifier  }
</pre>

<PRE create_plsql>
<B>CREATE</B> [ <B>OR</B> <B>REPLACE</B> ] 
[ <b>EDITIONABLE</b> | <b>NONEDITIONABLE</b> ]
{ /*subprg_i  |*/ subprg_i ; | subprg_i subprg_property ; |
 subprg_body | pkg_spec ; | pkg_body | trigger | 
 adt_definition | adt_definition ; |
 table_type_definition | table_type_definition ; |
 wrap <B>"/"</B> 
} 
-- [ / ] part of sql_stmt
</PRE>

<PRE wrap>
{ <B>PROCEDURE | FUNCTION | PACKAGE | PACKAGE BODY | TRIGGER 
| TYPE | TYPE BODY</B> } 
{ identifier | identifier . identifier }
<B>WRAPPED</B>
</PRE>


<PRE select>
subquery [ for_update_clause [order_by_clause] ] 
</PRE> -- no trailing semicol

<PRE insert>
<B>INSERT</B>  --[ hint ]
   { single_table_insert | multi_table_insert } </PRE> -- no trailing semicol
   
<PRE insert_into_clause>
<B>INTO</B> 
   aliased_dml_table_expression_clause -- was: dml_table_expression_clause [ t_alias ]
[ (column [, column ]...) ]</PRE>
   
<PRE aliased_dml_table_expression_clause>
   { dml_table_expression_clause
   | <B>ONLY</B> (dml_table_expression_clause)
   } [ t_alias ]
</PRE>
   
<PRE update>
<B>UPDATE</B> 
   { aliased_dml_table_expression_clause | <b>ONLY</b> ( aliased_dml_table_expression_clause ) }
   [for_compress]
   update_set_clause
   [ from_using_clause ]  
   [ where_clause ]
   [ order_by_clause ]
   [ returning_clause ]
   [error_logging_clause] 
</PRE> 

<<from_using_clause>>
   from_clause
 | USING cartesian_product 
<<>>

<PRE for_compress>
   <b>FOR COMPRESS</b> digits [, digits]...
</PRE>

   
<PRE delete>
<B>DELETE</B> 
   [ <B>FROM</B> ]
      { aliased_dml_table_expression_clause | <b>ONLY</b> ( aliased_dml_table_expression_clause ) }
     [ from_clause ]  
     [ from_using_clause ]    
     [ where_clause ]
     [ returning_clause ]
     [error_logging_clause]
</PRE> -- no trailing semicol

<PRE merge>
<B>MERGE</B> 
   <B>INTO</B> { [ schema. ] { table | table @ dblink }
         | ( subquery )
         }  [ t_alias ]
   [<B>USING</B> { [ schema. ] { table | table @ dblink }
         | ( subquery )
         | values_clause
         } [modified_external_table] [ t_alias ]]
   <B>ON</B> ( condition )
   [permutted_merge_insert_update]
   [ returning_clause ]
   [ error_logging_clause ]
</PRE> -- no trailing semicol
   
<pre permutted_merge_insert_update> {
  merge_insert_clause [merge_update_clause]
| merge_update_clause [merge_insert_clause]
}
</pre>   

<pre merge_insert_clause>
<b>WHEN NOT MATCHED THEN</b>
<b>INSERT</b> [ (column [, column ]...) ]
<b>VALUES</b> {
     par_expr_list  | expr
       }
[ where_clause ][ returning_clause ]
</pre>

<pre merge_update_clause>
<b>WHEN MATCHED THEN</b>
<b>UPDATE SET</b> column [(identifier)] = { expr | <b>DEFAULT</b> }
           [, column [(identifier)] = { expr | <b>DEFAULT</b> } ]...
[ where_clause ]
[ <b>DELETE</b> where_clause ]</pre>



<pre error_logging_clause>
<b>LOG ERRORS</b> 
  [ <b>INTO</b> [schema.] table ]
  [ (expr) | (subquery) ]     -- was simple_expression, need function calls https://community.oracle.com/thread/3976573
  [ reject_limit_unlimited ]
</pre>


<PRE with_clause>
<B>WITH</B>  {
  plsql_declarations  
  | subquery_factoring_clause
  | plsql_declarations subquery_factoring_clause
}</PRE>

<Pre plsql_declarations>
   subprg_body
|  plsql_declarations subprg_body
</Pre>


<pre subquery_factoring_clause>
  colmapped_query_name <B>AS</B> par_subquery [search_clause] [cycle_clause]
  [, colmapped_query_name <B>AS</B> par_subquery [search_clause] [cycle_clause]]...
|  
  subav_factoring_clause  
  [,subav_factoring_clause]
</pre>

<pre subav_clause>
   sub_av_clause
</pre>   

<PRE colmapped_query_name> 
query_name [(c_alias [, c_alias]...)]
</PRE>



<pre row_limiting_clause>
[ <b>OFFSET</b> expr { <b>ROW</b> | <b>ROWS</b> } ]
[ <b>FETCH [EXACT | APPROX | APPROXIMATE] [FIRST | NEXT]</b> 
    [ expr_percent [<b>{PARTITIONS| PARTITION} BY</b>] select_term [,] ]... 
    [<b>EACH WITH</b>] [ expr_percent ]
    { <b>ROW</b> | <b>ROWS</b> } [ <b>ONLY</b> | <b>WITH TIES</b> ] ] 
[accuracy_clause]   
</pre>

<<expr_percent>>
{ expr | expr <b>PERCENT</b> }
<<>>

<pre subquery> {
  select_clause from_clause  
| select_clause  
| (subquery)                          
| subquery SET_OPER subquery
| [ with_clause ] 
  subquery 
  [ "where,gby,hier" ]
  [ model_clause ]
  [ window_clause |
   <b>QUALIFY</b> condition
  ]...
  [ order_by_clause ]
  [ row_limiting_clause ]
}</pre>


<pre "where,gby,hier"> {
    where_clause
  | hierarchical_query_clause
  | "gby+having" 
  | where_clause hierarchical_query_clause
  | hierarchical_query_clause where_clause
  | where_clause "gby+having"
  | where_clause "gby+having" hierarchical_query_clause
  | where_clause hierarchical_query_clause "gby+having" 
  | "gby+having" hierarchical_query_clause
  | hierarchical_query_clause "gby+having" 
} </pre>

<pre "gby+having"> {
     group_by_clause
   | group_by_clause having_clause
   | having_clause group_by_clause
   | having_clause 
} </pre> 

<PRE select_clause> {                --> less rules generated when eliminating empty productions 
<B>SELECT</B>
 								  --> removed: [ hint ]
 [ distinct_unique_all ]
    select_list BULK_COLLECT_opt into_list_opt
}</pre>

<PRE from_clause> {
  <B>FROM</B> cartesian_product 
  [ table_tags_clause 
  | <B>FACT ROWS</B>]            
}</pre>

<PRE having_clause> {
  <B>HAVING</B> condition               
}</pre>


<PRE distinct_unique_all>                 
  { <B>DISTINCT | UNIQUE | ALL</B> } 
</pre>

<PRE cartesian_product> {
   table_reference_or_join_clause 
|  cartesian_product , table_reference_or_join_clause
} </pre>

<pre table_reference_or_join_clause>
  table_reference 
| join_clause | join_clause row_pattern_clause | join_clause row_pattern_clause t_alias
| (table_reference_or_join_clause)   
| (table_reference_or_join_clause)  t_alias 
| (table_reference_or_join_clause) identifier ( column [, column]... )
| table_reference_or_join_clause pivot_clause 
| table_reference_or_join_clause unpivot_clause
| table_reference_or_join_clause pivot_clause t_alias
| table_reference_or_join_clause unpivot_clause t_alias
</pre>

<PRE query_table_expression>
{ query_name
| [ schema. ]
  { table [ partition_extension_clause
          | modified_external_table
          | @ dblink
          ]
  -- Re Adrian: redundant   | { view /*| materialized view*/ } [ @ dblink ]
  | /*analytic_view*/identifier [ <b>HIERARCHIES</b>
    ( [ hier_ref [, hier_ref ]... ] ) ]
  | inline_external_table
  } [sample_clause]
| (subquery [ subquery_restriction_clause ])
| (query_table_expression)
| [ <b>LATERAL</b> ] (subquery [ subquery_restriction_clause ])
| table_collection_expression
| function_expression
| xmltable
| <B>ANALYTIC VIEW</B> (sub_av_clause)
| graph_table --correlation_or_recognition
| jsonize
| sqlplus_bindvar <b>.</b> <b>.</b> identifier
| <b>^</b> identifier <b>.</b> <b>.</b> identifier
}
</PRE>

<PRE sample_percent> 
    number
  | number , sample_percent
  | bind_var
</PRE>
<PRE seed_value> 
    number
  | bind_var
</PRE>


<PRE table_reference> {
{{ {<B>ONLY</B> (query_table_expression)| query_table_expression} 
   [ flashback_query_clause ]
   [ [ t_alias ] {  row_pattern_clause | nested_clause} ]
   | json_table [<b>AS</b>]
} | containers_clause }
  [ t_alias ]
| values_clause  
}</PRE>


<pre join_clause> {
  table_reference_or_join_clause "inner_cross_join_clause"
| table_reference_or_join_clause cross_outer_apply_clause
| table_reference_or_join_clause "outer_join_clause"
| table_reference_or_join_clause join_to_one_clause
} </pre>


<pre "inner_cross_join_clause">
{ [ <b>INNER</b> ] <b>JOIN</b> 
    table_reference_or_join_clause
    on_using_condition
| { <b>CROSS</b>
  | <b>NATURAL</b> [ <b>INNER</b> ]
  }
  <b>JOIN</b> table_reference_or_join_clause
}</pre>

<pre cross_outer_apply_clause>
{ <b>CROSS</b> | <b>OUTER</b> } <b>APPLY</b> { 
    table_reference_or_join_clause   -- Re Adrian: was table_reference which failed on http://savage.net.au/SQL/sql-2003-2.bnf.html#table reference 
  | collection_expression }
</pre>

<pre join_to_one_clause>
 <b>JOIN TO ONE</b> (join_to_one_items)
</pre>

<PRE join_to_one_items> {
   [outer_join_type <b>JOIN</b>]                 table_reference [on_using_condition] 
|  join_to_one_items ,                           table_reference [on_using_condition]
|  join_to_one_items outer_join_type <b>JOIN</b> table_reference [on_using_condition]
} </pre>


<pre "outer_join_clause">
{
  [ query_partition_clause ]
  outer_join_type <b>JOIN</b>
  table_reference_or_join_clause [ query_partition_clause ]
  on_using_condition
| [ query_partition_clause ]
  <b>NATURAL</b> outer_join_type <b>JOIN</b>
  table_reference_or_join_clause [ query_partition_clause ]
}
</pre>

<pre on_using_condition>
    { <b>ON</b> condition
    | <b>USING</b> (column [, column ]...)
    }
</pre>

<PRE group_by_clause>
<B>GROUP BY</B>
   parenthesized_group_by_list
   --there is dedicated having_clause symbol for [ <B>HAVING</B> condition ]
</PRE>

<PRE parenthesized_group_by_list>
   { <B>ALL</B>| group_by_list | (parenthesized_group_by_list) }
</PRE>

<PRE group_by_list>
   group_by_col
     [, group_by_col]...
</PRE>

<PRE group_by_col>
   { expr
   | rollup_cube_clause
   | grouping_sets_clause
   | (group_by_list)
   | ()
   }
</PRE>



<PRE cmp_op> -- refactored
{ = | == | != | ^= | ~= | not_eq }
</PRE>

<PRE simple_comparison_condition>
{ expr 
  { cmp_op | <b>></b> | <b><</b> | <b>></b>= | <b><</b>= }
  expr
| par_expr_list
  cmp_op
  {scalar_subquery_expression 
   | (par_expr_list)}  -- 27700079
| par_expr_list
  { cmp_op | <b>></b> | <b><</b> | <b>></b>= | <b><</b>= }
   par_expr_list 
}</PRE>

<PRE group_comparison_condition>
{ expr
  { cmp_op | <b>></b> | <b><</b> | <b>></b>= | <b><</b>= }
     { <B>ANY</B> | <B>SOME</B> | <B>ALL</B> }
     ({ expression_list | subquery })
| par_expr_list
  cmp_op
  { <B>ANY</B> | <B>SOME</B> | <B>ALL</B> }
  ({ expression_list
     [, expression_list ]...
   | subquery
   }
  )
}</PRE>

<pre datetime_expression>
expr <b>AT</b>
   { <b>LOCAL</b>
   | <b>TIME ZONE</b> { string_literal    -->was:  ' [ + | - ] hh:mm'
               | <b>DBTIMEZONE</b>
               | <b>SESSIONTIMEZONE</b>
               | string_literal           -->was:  'time_zone_name'
               | expr
               }
   }
</pre>


<pre table_compression>
 [<b>ROW STORE| COLUMN STORE</b>] compress_nocompress_basic_advanced [ <B>FOR</B> 
      { { <b>ALL</b> | <b>DIRECT_LOAD</b> } <b>OPERATIONS</b>  
      | { <b>QUERY</b> | <b>ARCHIVE</b> } [ <b>LEVEL</b> [= integer] ]
      | <b>OLTP</b>
      }  ]
      [ <b>LOW</b> | <b>HIGH</b> ]
  [ [<b>NO</b>] <b>ROW LEVEL LOCKING</b> ]
--| <b>NOCOMPRESS</b>
</pre>

<pre compress_nocompress_basic_advanced>
<b>{COMPRESS|NOCOMPRESS}</b> [ <b>BASIC | ADVANCED</b> ]
</pre>

/*<PRE user_defined_function>
-- this should be in expr: [function.]      -- a().b()
