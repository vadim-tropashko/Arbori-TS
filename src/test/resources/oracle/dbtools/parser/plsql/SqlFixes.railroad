-- fixed content from http://st-doc.us.oracle.com/sql_grammar/sqlbnf/bnffiles/
-- http://st-doc.us.oracle.com/database/121/SQLRF/img_text/
-- http://st-doc.us.oracle.com/sql_grammar/sqlbnf112/bnffiles

<PRE sql_statements> {
     sql_statement
   | sql_statements sql_statement
}</PRE>

<PRE sql_statement> {
     library_unit    -- follows: unlabeled_nonblock_stmt -> sql_stmt ';'
   | library_unit <B>/</B>
   | call_statement  -- library_unit includes it with trailing semicolon
   | exec_immediate_statement <b>;</b>
   | sql_stmt <B>/</B>    -- e.g. ++1671;  /*  wrap.htm#CEGGEEFH  */ SELECT COUNT(*) FROM EMPLOYEES /
   | sql_stmt <b>;</b>
   | sql_statement <B>/</B>
--   | sql_stmt ';' --> library_unit -> unlabeled_nonblock_stmt -> sql_stmt ';' 
   | create
   | create ;
   | create <B>/</B>
   | drop
   | drop ;
   | drop <B>/</B>
   | alter
   | alter ;
   | alter <B>/</B>
   | grant
   | grant <B>/</B>
   
/*** | select ;   --> sql_query_or_dml_stmt --> sql_stmt
*    | insert ;   *
*    | delete ;   *
*    | update ;   *
*    | merge ;  ***/
   | delete
   
   | comment --;
   | truncate_table
   | set_transaction 
   | rename
   | administer_key_management
   | set_constraints
   | set_role
   | set_use_data_grants_only
   | set_use_data_grants_only ;
   | revoke
   | revoke_data_role
   | revoke_data_role ;
   | audit
   | noaudit
   | unified_audit
   | unified_noaudit
   | explain_plan
   | analyze
   | associate_statistics
   | disassociate_statistics
   | truncate_cluster
   | truncate_table
   | lock_table
   | flashback_database
   | flashback_table
   | purge
   | purge <B>/</B>
   | rollback   
   | sqlplus_command
   | dbtools_command
}</PRE>


