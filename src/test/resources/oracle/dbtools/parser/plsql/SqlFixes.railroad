                    FOR   INSERT { ONLY | AND UPDATE } [number]
                  | FOR ( INSERT { ONLY | AND UPDATE } [number])
                  ] 
        ] {expr|condition}
<<>>
  
<< create_domain >>{ 
    create_single_column_domain 
  | create_multi_column_domain 
  | create_flexible_domain 
  | CREATE DOMAIN [IF NOT EXISTS][schema.]domain_name AS JSON VALIDATE [USING] string_literal
  | CREATE DOMAIN [IF NOT EXISTS][schema.]domain_name AS ENUM( enum_lst [,] ) [datatype_possibly_strict]     
} <<>>
 
<<create_multi_column_domain>>
CREATE DOMAIN [ IF NOT EXISTS ][ schema .] domain_name AS
(  domain_column_def [, domain_column_def]... )
[constraint_clause
 | inline_constraint
 | DISPLAY display_expression 
 | ORDER order_expression 
 | annotations_clause ]...
<<>>

<<constraint_clause>> 
[
CONSTRAINT [ constraint_name ] { [NOT] NULL | CHECK ( condition )} constraint_state 
|
CONSTRAINT [ constraint_name ] { [NOT] NULL | CHECK ( condition )} 
|
CONSTRAINT [ constraint_name ]  constraint_state 
]...
<<>>

