<PRE aggregate_function> 
     z_aggr_opt_keep 
   | opt_FINAL_RUNNING {"aggr_name"( "expr_list" ) | xmlagg} [keep_clause] 
   | function_call keep_clause  -- regression.test ++170;
   | any_value
   | approx_median
   | approx_percentile
   | approx_rank
   | approx_sum
   | count 
   | approx_count 
   | avg 
   | cume_dist_aggregate
   | dense_rank_aggregate
   | collect
   //| json_arrayagg   
   //| json_objectagg
   | listagg
   | percentile_cont
   | percentile_disc
   | percent_rank_aggregate
   | rank_aggregate
   | skewness_pop
   | skewness_samp
   | stddev
   | sum
   
   | aggregate_function <B>FILTER ( WHERE</B> condition )
</PRE>

<pre z_aggr_opt_keep>
     {aggr_call | xmlagg} [keep_clause] 
</PRE>

<pre aggr_call>
     "aggr_name" paren_expr_list 
    | "aggr_name" ()
</PRE>



<PRE xmlagg>
<B>XMLAGG</B>(expr [ order_by_clause ])
</PRE>

<PRE keep_clause>   -- was orphan first.html
   <B>KEEP</B>
   (<B>DENSE_RANK</B> {<B>FIRST|LAST</B>} <B>ORDER BY</B>
    expr_desc_asc_nulls
    [, expr_desc_asc_nulls]...
   )
   [ <B>OVER</B> ( [query_partition_clause] ) ]</PRE>
   
<PRE expr_desc_asc_nulls>
    expr [ <B>DESC</B> | <B>ASC</B> ]
         [ <B>NULLS</B> { <B>FIRST</B> | <B>LAST</B> } ]
</PRE>

<pre pivot_clause>
--table_reference    no such thing on doc train diagram 
<b>PIVOT</b> [ <b>XML</b> ]
  ( expr [as_alias ]           -- 33650551
      [, expr [as_alias ] ]...
    pivot_for_clause
    pivot_in_clause
  )
</pre>

<pre unpivot_clause>
--table_reference  ditto
<b>UNPIVOT</b> [ {<b>INCLUDE</b> | <b>EXCLUDE</b>} <b>NULLS</b> ]
( { column | ( column [, column]... ) }
  pivot_for_clause
  unpivot_in_clause
)</pre>


