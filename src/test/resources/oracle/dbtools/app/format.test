    RULES UPSERT SEQUENTIAL ORDER ( s[prod = 'Mouse Pad', year = 2000]= s['Mouse Pad',
    1998]+ s['Mouse Pad',
    1999],
    s['Standard Mouse', 2001]= s['Standard Mouse',
    2000])`
