++557;  /* 31559809 */
`
clear screen
set pages 80 lines 90 feed off
 
-- COL Settings
col db_det  for a80 head "Database Details"
col tname   for a40 head "Tablespace"
col name    for a40 head "File Type"
col datasize for 99,999 head "File Size [GB]"
col tbssize   for 99,999 head "User Data[GB]"
-- COL Settings
 
BTITLE OFF
TTITLE CENTER "=======================================================" SKIP 
1 -
       CENTER "    Database Size Stats" SKIP 1 -
       CENTER "=======================================================" SKIP 
1
 
with dbdetails as (select * from v$instance)
select 'Instance: ' || instance_name as db_det from dbdetails
union all
select ' On Host: ' || host_name as db_det from dbdetails
union all
select '   As of: ' || systimestamp as db_det from dbdetails;
TTITLE OFF
 
-- Start SQL
prompt
prompt *****************************************************************
prompt ++ OS Footprint ++
prompt *****************************************************************
 
BREAK ON report SKIP 1;
COMPUTE SUM LABEL 'TOTAL OS Footprint [GB]' OF datasize ON report;
 
With files as (
        SELECT 'Datafiles' name, round(SUM(bytes) / 1024 / 1024 / 1024) 
datasize FROM dba_data_files
        union all
        SELECT 'Tempfiles', round(nvl(SUM(bytes), 0) / 1024 / 1024 / 1024) 
datasize  FROM dba_temp_files
        union all
        SELECT 'Redo Logs' ,round(SUM(bytes) / 1024 / 1024 / 1024)  datasize 
FROM sys.v_$log
        union all
        SELECT 'Controlfiles' , round(SUM(block_size * file_size_blks) / 1024 
/ 1024 / 1024) datasize  FROM v$controlfile)
select name , datasize  from files;
 
 
prompt *****************************************************************
prompt ++ User Data Size ++
prompt *****************************************************************
 
BREAK ON report SKIP 1;
COMPUTE SUM LABEL 'TOTAL User Data [GB]' OF tbssize ON report;
 
select
    tablespace_name tname, round(sum(bytes) /(1024 * 1024 * 1024)) tbssize
from
    dba_segments
where
    tablespace_name not in (
        'SYSTEM'
      , 'SYSAUX'
      , 'UNDOTBS1'
      , 'TEMP'
      , 'USERS'
    )
group by tablespace_name;
`      
