SELECT  /* QUERY_SRC('datamodel: _OAL_Custom_Human_Capital_Management_Workflow_Notifications_Data_Model_EmploymentUpdateProcesses_xdm,dataset:DeletedRecords') */
      extractvalue(value(managertype), '//BIPData/BIPOperation')                                   AS "Value",
      extractvalue(value(managertype), '//BIPData/BIPElementEntryId')                              AS "ElementEntryId",
      extractvalue(value(managertype), '//BIPData/BIPElementTypeId')                               AS "ElementTypeId",
      extractvalue(value(managertype), 'ElementEntryDEORow/BIPData/BIPEffectiveStartDate')         AS "StartDate",
      extractvalue(value(managertype), 'ElementEntryDEORow/DEEOData/LastAppliedDEMode')            AS "DeleteMode",
      extractvalue(value(managertype), 'ElementEntryDEORow/DEEOData/VED')                          AS "EndDate"
  FROM
      hrc_txn_data                                                                                 txndata,     
      TABLE ( xmlsequence(extract(xmltype(''                                                                                             
                                          || txndata.data_cache                                                                                
                                          || ''), '//ElementEntryDEORow')) )                       managertype                          
  WHERE
          txndata.transaction_id = :transid
      AND extractvalue(value(managertype), '//BIPData/BIPOperation') = 'DELETE'
      AND extractvalue(value(managertype), 'ElementEntryDEORow/DEEOData/LastAppliedDEMode') = 10
      AND EXISTS (
          SELECT                                                                                                                               
              1                                                                                                                                
          FROM                                                                                                                                 
              per_all_assignments_m                                                                                                            
          WHERE                                                                                                                                
                  assignment_id = extractvalue(xmltype(''                                                                                
                                                   || txndata.data_cache                                                                       
                                                   || ''), 'root/TRANSACTION1/TransCtx1/AssignmentId1')                                 
              AND ( per_notification_security.securedata('CMP_MANAGE_VARIABLE_COMPENSATION_ALLOCATION_BY_WORKER_DATA', 'PER_ALL_ASSIGNMENTS_M',
              assignment_id, effective_start_date, effective_end_date,                                                                         
                                                         effective_latest_change, effective_sequence) = 'T'                                    
                    OR per_notification_security.securedata('CMP_ENTER_VARIABLE_COMPENSATION_ALLOCATION_DATA', 'PER_ALL_ASSIGNMENTS_M',        
                    assignment_id, effective_start_date, effective_end_date,                                                                   
