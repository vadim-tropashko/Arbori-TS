create or replace and compile java source named cmdj as
public class cmdj
{
  public static int runcmd(String args)
  {

    Runtime rt = Runtime.getRuntime();
    int rc = -1;
    try
    {
       Process p = rt.exec(args);

       try
       {
         outEater.start();
       }
       catch (Exception e) { e.printStackTrace(); }

       rc = p.waitFor();
       return rc;
    }

    catch (Exception e)
    {
       e.printStackTrace();
       return -1;
    }
  }
}

